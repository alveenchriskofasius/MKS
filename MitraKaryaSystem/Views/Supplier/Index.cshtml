@{
	ViewData["Title"] = "Supplier";
}
<style>
	/* ── Supplier list (reuse customer list pattern) ── */
	.cust-list { list-style: none; padding: 0; margin: 0; }
	.cust-list-item {
		padding: .6rem .85rem; border-radius: 8px; cursor: pointer;
		display: flex; align-items: center; gap: .75rem;
		transition: all .2s; margin-bottom: 4px; border: 1px solid transparent;
	}
	.cust-list-item:hover { background: var(--mks-gray-100); }
	.cust-list-item.active { background: var(--mks-primary-light); border-color: var(--mks-primary); }
	.cust-avatar {
		width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
		font-weight: 700; font-size: .82rem; text-transform: uppercase; flex-shrink: 0;
		background: var(--mks-primary-light); color: var(--mks-primary);
	}
	.cust-list-item.active .cust-avatar { background: var(--mks-primary); color: #fff; }
	.cust-info { min-width: 0; flex: 1; }
	.cust-info .cust-name { font-weight: 600; font-size: .85rem; color: var(--mks-gray-800); }
	.cust-list-item.active .cust-info .cust-name { color: var(--mks-primary); }
	.cust-info .cust-detail { font-size: .72rem; color: var(--mks-gray-600); }
	.cust-list-item .cust-badge { margin-left: auto; flex-shrink: 0; }
</style>
<div class="fade-slide-up">
	<div class="card page-header-card">
		<div class="card-header card-header-accent">
			<div class="d-flex align-items-center gap-2">
				<i class="fa fa-truck fa-lg"></i>
				<h5 class="mb-0">Suppliers</h5>
			</div>
			<div class="d-flex gap-2">
				<button class="btn btn-sm btn-outline-light" id="buttonAdd"><i class="fa-solid fa-plus"></i> New Supplier</button>
			</div>
		</div>
		<div class="card-body p-0">
			<div class="row g-0">
				<div class="col-md-4 col-lg-3 border-end" style="min-height:520px">
					<div class="p-3">
						<div class="input-group input-group-sm mb-2">
							<span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
							<input type="text" class="form-control" id="supplierSearch" placeholder="Search suppliers…">
						</div>
						<ul class="cust-list" id="supplierList">
							<li class="text-center text-muted py-4"><small>Loading…</small></li>
						</ul>
					</div>
				</div>
				<div class="col-md-8 col-lg-9">
					<div id="supplierFormPanel" class="p-3">
						<div class="empty-state" id="supplierEmptyState">
							<i class="fa fa-truck"></i>
							<p>Select a supplier to edit or create a new one</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script src="~/js/Supplier.js" asp-append-version="true"></script>
	<script src="~/js/Common.js" asp-append-version="true"></script>
}
