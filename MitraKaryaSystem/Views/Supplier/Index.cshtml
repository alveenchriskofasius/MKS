@{
	ViewData["Title"] = "Supplier";
}
<div class="fade-slide-up">
	<div class="card page-header-card">
		<div class="card-header card-header-accent">
			<div class="d-flex align-items-center gap-2">
				<i class="fa fa-truck fa-lg"></i>
				<h5 class="mb-0">Suppliers</h5>
			</div>
			<div class="d-flex gap-2">
				<button class="btn btn-sm btn-outline-light" id="buttonAdd"><i class="fa-solid fa-plus"></i> New Supplier</button>
			</div>
		</div>
		<div class="card-body p-0">
			<div class="row g-0">
				<div class="col-md-4 col-lg-3 border-end" style="min-height:520px">
					<div class="p-3">
						<div class="input-group input-group-sm mb-2">
							<span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
							<input type="text" class="form-control" id="supplierSearch" placeholder="Search suppliers…">
						</div>
						<ul class="cust-list" id="supplierList">
							<li class="text-center text-muted py-4"><small>Loading…</small></li>
						</ul>
					</div>
				</div>
				<div class="col-md-8 col-lg-9">
					<div id="supplierFormPanel" class="p-3">
						<div class="empty-state" id="supplierEmptyState">
							<i class="fa fa-truck"></i>
							<p>Select a supplier to edit or create a new one</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script src="~/js/Supplier.js" asp-append-version="true"></script>
	<script src="~/js/Common.js" asp-append-version="true"></script>
}
