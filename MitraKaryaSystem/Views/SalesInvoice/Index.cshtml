@{
    ViewData["Title"] = "Sales Invoice";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-file-invoice fa-lg"></i>
                <h5 class="mb-0">Sales Invoice</h5>
            </div>
        </div>
        <div class="card-body">
            <table class="table table-hover table-sm align-middle" id="tableSalesInvoice" style="width:100%">
                <thead class="table-light"><tr><th>No</th><th>Date</th><th>Customer</th><th class="text-end">Amount</th><th class="text-end">Paid</th><th>Status</th><th style="width:80px"></th></tr></thead>
            </table>
        </div>
    </div>
</div>
<partial name="_PaymentInModal" />
@section Scripts {
    <script src="/js/PaymentIn.js"></script>
    <script src="/js/SalesInvoice.js"></script>
}
