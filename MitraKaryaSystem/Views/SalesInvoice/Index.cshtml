@{
    ViewData["Title"] = "Sales Invoice";
}
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="fw-bold"><i class="fa fa-file-invoice"></i> Sales Invoice</h3>
    </div>
    <div class="card">
        <div class="card-body">
            <table class="table table-sm" id="tableSalesInvoice" style="width:100%">
                <thead class="table-light"><tr><th>No</th><th>Date</th><th>Customer</th><th class="text-end">Amount</th><th class="text-end">Paid</th><th>Status</th><th></th></tr></thead>
            </table>
        </div>
    </div>
</div>
<partial name="_PaymentInModal" />
@section Scripts {
    <script src="/js/PaymentIn.js"></script>
    <script src="/js/SalesInvoice.js"></script>
}
