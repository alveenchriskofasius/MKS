@{
	ViewData["Title"] = "Master Settings";
	var rawPerms = User?.Claims?.Where(c => string.Equals(c.Type, "Permission", StringComparison.OrdinalIgnoreCase)).Select(c => c.Value).ToList() ?? new List<string>();
	var permsNorm = new HashSet<string>(rawPerms.Select(p => (p ?? string.Empty).Replace(" ", "")), StringComparer.OrdinalIgnoreCase);
	bool CanSee(string perm) => permsNorm.Contains((perm ?? "").Replace(" ", ""));

	var showCategory = CanSee("Category");
	var showUnit = CanSee("Unit");
	var showStoreProfile = true;
	var storeProfileActive = true;
	var categoryActive = !showStoreProfile && showCategory;
	var unitActive = !showStoreProfile && !showCategory && showUnit;
}
<div class="fade-slide-up">
	<div class="card page-header-card">
		<div class="card-header card-header-accent">
			<div class="d-flex align-items-center gap-2">
				<i class="fa fa-cogs fa-lg"></i>
				<h5 class="mb-0">Master Settings</h5>
			</div>
		</div>
		<div class="card-body">
			<ul class="nav nav-tabs mb-3" id="masterSettingTabs" role="tablist">
				@if (showStoreProfile)
				{
					<li class="nav-item" role="presentation">
						<button class="nav-link @(storeProfileActive ? "active" : "")" id="tab-storeprofile" data-bs-toggle="tab" data-bs-target="#pane-storeprofile" type="button" role="tab">
							<i class="fa fa-store me-1"></i> Store Profile
						</button>
					</li>
				}
				@if (showCategory)
				{
					<li class="nav-item" role="presentation">
						<button class="nav-link @(categoryActive ? "active" : "")" id="tab-category" data-bs-toggle="tab" data-bs-target="#pane-category" type="button" role="tab">
							<i class="fa fa-tags me-1"></i> Categories
						</button>
					</li>
				}
				@if (showUnit)
				{
					<li class="nav-item" role="presentation">
						<button class="nav-link @(unitActive ? "active" : "")" id="tab-unit" data-bs-toggle="tab" data-bs-target="#pane-unit" type="button" role="tab">
							<i class="fa fa-ruler me-1"></i> Units
						</button>
					</li>
				}
			</ul>
			<div class="tab-content" id="masterSettingContent">
				@if (showStoreProfile)
				{
					<div class="tab-pane fade @(storeProfileActive ? "show active" : "")" id="pane-storeprofile" role="tabpanel">
						<div class="row justify-content-center">
							<div class="col-lg-8 col-xl-6">
								<div class="mb-3">
									<label class="form-label fw-semibold">Store Name</label>
									<input type="text" id="spStoreName" class="form-control form-control-sm" placeholder="e.g. Mitra Karya" />
								</div>
								<div class="mb-3">
									<label class="form-label fw-semibold">Address</label>
									<textarea id="spAddress" class="form-control form-control-sm" rows="2" placeholder="Store address"></textarea>
								</div>
								<div class="row">
									<div class="col-md-6 mb-3">
										<label class="form-label fw-semibold">Phone</label>
										<input type="text" id="spPhone" class="form-control form-control-sm" placeholder="e.g. 0812-xxxx-xxxx" />
									</div>
									<div class="col-md-6 mb-3">
										<label class="form-label fw-semibold">Email</label>
										<input type="email" id="spEmail" class="form-control form-control-sm" placeholder="e.g. info@mitrakarya.com" />
									</div>
								</div>
								<hr />
								<h6 class="fw-semibold"><i class="fa fa-receipt me-1 text-muted"></i> Receipt Settings</h6>
								<div class="mb-3">
									<label class="form-label fw-semibold">Receipt Header <small class="text-muted">(subtitle below store name)</small></label>
									<input type="text" id="spReceiptHeader" class="form-control form-control-sm" placeholder="e.g. Jl. Contoh No.123, Kota" />
								</div>
								<div class="mb-3">
									<label class="form-label fw-semibold">Receipt Footer</label>
									<input type="text" id="spReceiptFooter" class="form-control form-control-sm" placeholder="e.g. Terima kasih atas kunjungan Anda!" />
								</div>
								<button class="btn btn-primary" id="spBtnSave"><i class="fa fa-save me-1"></i> Save Store Profile</button>
							</div>
						</div>
					</div>
				}
				@if (showCategory)
				{
					<div class="tab-pane fade @(categoryActive ? "show active" : "")" id="pane-category" role="tabpanel">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<div class="input-group input-group-sm" style="max-width:300px">
								<span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
								<input type="text" class="form-control" id="categorySearch" placeholder="Search categories…">
							</div>
							<button class="btn btn-sm btn-primary" id="buttonAddCategory"><i class="fa-solid fa-plus me-1"></i> New Category</button>
						</div>
						<div class="row">
							<div class="col-md-6">
								<div class="table-responsive">
									<table class="table table-sm table-hover align-middle" id="tableCategory">
										<thead class="table-light">
											<tr>
												<th>Name</th>
												<th class="text-center" style="width:120px">Action</th>
											</tr>
										</thead>
										<tbody></tbody>
									</table>
								</div>
							</div>
							<div class="col-md-6" id="categoryFormPanel">
								<div class="empty-state">
									<i class="fa fa-tags"></i>
									<p>Select a category to edit or create a new one</p>
								</div>
							</div>
						</div>
					</div>
				}
				@if (showUnit)
				{
					<div class="tab-pane fade @(unitActive ? "show active" : "")" id="pane-unit" role="tabpanel">
						<div class="d-flex justify-content-between align-items-center mb-3">
							<div class="input-group input-group-sm" style="max-width:300px">
								<span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
								<input type="text" class="form-control" id="unitSearch" placeholder="Search units…">
							</div>
							<button class="btn btn-sm btn-primary" id="buttonAddUnit"><i class="fa-solid fa-plus me-1"></i> New Unit</button>
						</div>
						<div class="row">
							<div class="col-md-6">
								<div class="table-responsive">
									<table class="table table-sm table-hover align-middle" id="tableUnit">
										<thead class="table-light">
											<tr>
												<th>Name</th>
												<th class="text-center" style="width:120px">Action</th>
											</tr>
										</thead>
										<tbody></tbody>
									</table>
								</div>
							</div>
							<div class="col-md-6" id="unitFormPanel">
								<div class="empty-state">
									<i class="fa fa-ruler"></i>
									<p>Select a unit to edit or create a new one</p>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script src="~/js/shared/MksStoreProfile.js" asp-append-version="true"></script>
	<script src="~/js/Category.js" asp-append-version="true"></script>
	<script src="~/js/Unit.js" asp-append-version="true"></script>
	<script src="~/js/Common.js" asp-append-version="true"></script>
	<script>
		(function(){
			MksStoreProfile.load(true).then(function(p){
				$('#spStoreName').val(p.storeName||'');
				$('#spAddress').val(p.address||'');
				$('#spPhone').val(p.phone||'');
				$('#spEmail').val(p.email||'');
				$('#spReceiptHeader').val(p.receiptHeader||'');
				$('#spReceiptFooter').val(p.receiptFooter||'');
			});
			$('#spBtnSave').on('click', function(){
				var $btn = $(this).prop('disabled',true).html('<span class="spinner-border spinner-border-sm"></span> Saving...');
				MksStoreProfile.save({
					storeName: $('#spStoreName').val().trim(),
					address: $('#spAddress').val().trim(),
					phone: $('#spPhone').val().trim(),
					email: $('#spEmail').val().trim(),
					receiptHeader: $('#spReceiptHeader').val().trim(),
					receiptFooter: $('#spReceiptFooter').val().trim()
				}).then(function(res){
					if(res && res.success) toastr.success('Store profile saved');
					else toastr.error((res && res.error) || 'Failed');
				}).catch(function(){ toastr.error('Failed to save'); })
				.always(function(){ $btn.prop('disabled',false).html('<i class="fa fa-save me-1"></i> Save Store Profile'); });
			});
		})();
	</script>
}
