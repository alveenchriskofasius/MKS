<div class="table-responsive">
    <table class="table table-hover table-sm align-middle" id="tableProduct" style="width:100%">
        <thead class="table-light">
            <tr>
                <th hidden>ID</th>
                <th hidden>ProductID</th>
                <th>Product</th>
                <th class="text-end" style="width:100px">Ordered Qty</th>
                <th class="text-end" style="width:100px">Received Qty</th>
                <th class="text-end" style="width:100px">Discrepancy</th>
                <th class="text-end" style="width:120px">Unit Price</th>
                <th hidden>SupplierID</th>
                <th hidden>Barcode</th>
                <th>Supplier</th>
                <th style="width:80px" class="text-center">Action</th>
            </tr>
        </thead>
        <tbody></tbody>
        <tfoot class="table-group-divider">
            <tr>
                <td colspan="3" class="text-end fw-bold">Total</td>
                <td id="totalOrderedQty" class="text-end fw-bold">0</td>
                <td id="totalQty" class="text-end fw-bold">0</td>
                <td id="totalDiscrepancy" class="text-end fw-bold">0</td>
                <td id="totalUnitPrice" class="text-end fw-bold">0</td>
                <td colspan="4"></td>
            </tr>
        </tfoot>
    </table>
</div>