<div class="table-responsive">
    <table class="table table-bordered table-hover" cellpadding="0" cellspacing="0" style="text-align:center" width="100%" id="tableProduct">
        <thead>
            <tr>
                <th hidden>ProductID</th>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th hidden>SupplierID</th>
                <th hidden>Barcode</th>
                <th>Supplier</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
        <tfoot>
            <tr>
                <td colspan="2" class="text-end fw-bold">Total</td>
                <td id="totalQty" class="fw-bold">0</td>
                <td id="totalUnitPrice" class="fw-bold">0</td>
                <td colspan="4" class="text-start fw-bold"></td>
            </tr>
        </tfoot>
    </table>
</div>