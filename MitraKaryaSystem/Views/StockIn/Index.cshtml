@{
    ViewData["Title"] = "Stock In";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-boxes-stacked fa-lg"></i>
                <h5 class="mb-0">Stock In</h5>
            </div>
            <div class="d-flex gap-2">
                <button type="button" id="buttonNew" class="btn btn-sm btn-outline-light"><i class="fa-solid fa-plus"></i> New</button>
                <button type="button" id="buttonSearch" class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#searchModal"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
            </div>
        </div>
        <div class="card-body">
            <!-- Status & workflow -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="workflow-bar" id="siWorkflowBar">
                    <div class="wf-step active" data-step="1"><span class="wf-dot"></span> Draft</div>
                    <i class="fa fa-chevron-right wf-arrow"></i>
                    <div class="wf-step" data-step="2"><span class="wf-dot"></span> Submitted</div>
                    <i class="fa fa-chevron-right wf-arrow"></i>
                    <div class="wf-step" data-step="3"><span class="wf-dot"></span> Verified</div>
                </div>
                <span class="badge-status badge-draft" id="stockInStatus">Draft</span>
            </div>

            <!-- Form -->
            <div class="card mb-3">
                <div class="card-body" id="stockInHeaderBody">
                    <partial name="_FormHeader" model="new StockInModel()" />
                </div>
            </div>

            <!-- Product selection -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Add Product</label>
                            <select class="form-control select2" id="selectProduct" autofocus></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold">Quantity</label>
                            <input type="number" class="form-control" id="quantity" min="1" value="1" />
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-success w-100" id="buttonAdd"><i class="fa-solid fa-plus"></i> Add Product</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items table -->
            <partial name="_Table" />
        </div>
        <div class="card-footer d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-info d-none" id="buttonSubmit"><i class="fa fa-paper-plane"></i> Submit</button>
            <button type="button" class="btn btn-outline-success d-none" id="buttonVerify"><i class="fa fa-check"></i> Verify</button>
            <button type="submit" class="btn btn-primary" id="buttonSave"><i class="fa fa-save"></i> Save</button>
            <button type="button" class="btn btn-outline-secondary" id="buttonPrint"><i class="fa fa-print"></i> Print</button>
            <a class="btn btn-secondary ms-auto" asp-action="Index" asp-controller="Home" id="buttonCancel"><i class="fa fa-arrow-left"></i> Back</a>
        </div>
    </div>
</div>
<partial name="_TableSearch" />

@section Scripts {
    <script src="~/js/StockIn.js" asp-append-version="true"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
}