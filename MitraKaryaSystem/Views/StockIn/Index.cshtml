@{
    ViewData["Title"] = "Stock In";
}
<div class="card">
    <div class="card-header" style="background-color:#f0f0f0">
        <div class="card-title">
            <h5>Stock In</h5>
        </div>
        <div class="card-tools">
            <button type="button" id="buttonNew" class="btn btn-primary btn-sm"><i class="fa-solid fa-file-circle-plus"></i> Add</button>
            <button type="button" id="buttonSearch" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#searchModal"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
        </div>
    </div>
    <div class="card-body">
        <div class="card">
            <div class="card-header">
                <div class="card-title">
                    <span class="badge rounded-pill text-bg-warning" id="stockInStatus">Draft</span>
                </div>
            </div>
            <div class="card-body" id="stockInHeaderBody">
                <partial name="_FormHeader" model="new StockInModel()" />
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <label for="selectProduct" class="form-label col-sm-2">Select Product</label>
                    <div class="col-md-10 col-lg-10">
                        <select class="form-control select2" id="selectProduct" autofocus></select>
                    </div>
                </div>
                <div class="row mb-3">
                    <label for="quantity" class="form-label col-sm-2">Quantity</label>
                    <div class="col-md-4 col-lg-4">
                        <input type="number" class="form-control" id="quantity" min="1" value="1" />
                    </div>
                    <div class="col-md-6 col-lg-6">
                        <button type="button" class="btn btn-success" id="buttonAdd"><i class="fa-solid fa-plus"></i> Add Product</button>
                    </div>
                </div>
            </div>
        </div>
        <partial name="_Table" />
    </div>
    <div class="card-footer">
        <button type="submit" class="btn btn-primary" id="buttonSave">Save</button>
        <a class="btn btn-secondary" asp-action="Index" asp-controller="Home" id="buttonCancel">Cancel</a>
    </div>
</div>
<partial name="_TableSearch" />

@section Scripts {
    <script src="~/js/StockIn.js" asp-append-version="true"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
}