@{
    ViewData["Title"] = "Expense";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-receipt fa-lg"></i>
                <h5 class="mb-0">Expense Management</h5>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" id="btnNewExpense" data-bs-toggle="modal" data-bs-target="#expenseModal">
                    <i class="fa-solid fa-plus"></i> New Expense
                </button>
            </div>
        </div>
        <div class="card-body">
            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm" style="background:linear-gradient(135deg,#fee2e2 0%,#fecaca 100%)">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:52px;height:52px;background:#dc2626;color:#fff">
                                    <i class="fa fa-money-bill-trend-up fa-lg"></i>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">This Month</div>
                                    <div class="fw-bold fs-5" id="sumThisMonth" style="color:#dc2626">Rp 0</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm" style="background:linear-gradient(135deg,#e0e7ff 0%,#c7d2fe 100%)">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:52px;height:52px;background:#4f46e5;color:#fff">
                                    <i class="fa fa-calendar-days fa-lg"></i>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">Last Month</div>
                                    <div class="fw-bold fs-5" id="sumLastMonth" style="color:#4f46e5">Rp 0</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm" style="background:linear-gradient(135deg,#dcfce7 0%,#bbf7d0 100%)">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:52px;height:52px;background:#16a34a;color:#fff">
                                    <i class="fa fa-chart-pie fa-lg"></i>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">Categories</div>
                                    <div class="fw-bold fs-5" id="sumCategories" style="color:#16a34a">0</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category Breakdown -->
            <div class="row g-2 mb-4" id="categoryBreakdown"></div>

            <!-- Filters -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">From</label>
                            <input type="date" class="form-control form-control-sm" id="filterFrom" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">To</label>
                            <input type="date" class="form-control form-control-sm" id="filterTo" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">Category</label>
                            <select class="form-select form-select-sm" id="filterCategory">
                                <option value="All">All Categories</option>
                                <option>BBM / Transportasi</option>
                                <option>Listrik & Air</option>
                                <option>Gaji Karyawan</option>
                                <option>Sewa</option>
                                <option>Maintenance</option>
                                <option>Perlengkapan</option>
                                <option>Makan & Minum</option>
                                <option>Lainnya</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button class="btn btn-sm btn-primary flex-fill" id="btnFilter"><i class="fa fa-filter me-1"></i>Filter</button>
                            <button class="btn btn-sm btn-outline-secondary" id="btnReset"><i class="fa fa-rotate-left"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Expense Table -->
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle" id="tableExpense" style="width:100%">
                    <thead class="table-light">
                        <tr>
                            <th>No</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th class="text-end">Amount</th>
                            <th>By</th>
                            <th class="text-center" style="width:100px">Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Expense Modal -->
<div class="modal fade" id="expenseModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background:linear-gradient(135deg,#1e3a5f,#2563eb);color:#fff">
                <h5 class="modal-title" id="expenseModalTitle"><i class="fa fa-receipt me-2"></i>New Expense</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="expenseForm" novalidate>
                    <input type="hidden" id="expenseID" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="expenseDate" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Category <span class="text-danger">*</span></label>
                        <select class="form-select" id="expenseCategory" required>
                            <option value="">-- Select Category --</option>
                            <option>BBM / Transportasi</option>
                            <option>Listrik & Air</option>
                            <option>Gaji Karyawan</option>
                            <option>Sewa</option>
                            <option>Maintenance</option>
                            <option>Perlengkapan</option>
                            <option>Makan & Minum</option>
                            <option>Lainnya</option>
                        </select>
                        <div class="invalid-feedback">Please select a category.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Description</label>
                        <textarea class="form-control" id="expenseDescription" rows="2" placeholder="e.g. BBM truck kirim material"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">Rp</span>
                            <input type="number" step="1" min="1" class="form-control" id="expenseAmount" required placeholder="0" />
                        </div>
                        <div class="invalid-feedback">Please enter an amount.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveExpense">
                    <span class="spinner-border spinner-border-sm d-none"></span>
                    <i class="fa fa-save me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Expense.js" asp-append-version="true"></script>
}
