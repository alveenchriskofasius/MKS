@model ProductViewModel
@{
    var categoryID = Model.ProductModel.CategoryID;
    var supplierID = Model.ProductModel.SupplierID;
    var unitID = Model.ProductModel.UnitID;
}
<form id="productForm">
    <input asp-for="ProductModel.ID" type="text" hidden />
    <div class="row mb-3">
        <label class="form-label col-sm-2">Name<span class="asterisk">*</span></label>
        <div class="col-sm-9">
            <input type="text" asp-for="ProductModel.Name" required class="form-control" />
            <div class="invalid-feedback">Please enter a valid name.</div>
        </div>
    </div>
    <div class="row mb-3">
        <label class="form-label col-sm-2">Barcode</label>
        <div class="col-sm-9">
            <input type="text" asp-for="ProductModel.Barcode" class="form-control" />
        </div>
    </div>
    <div class="row mb-3">
        <label class="form-label col-sm-2">Description</label>
        <div class="col-sm-9">
            <input type="text" asp-for="ProductModel.Description" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <label for="unitPrice" class="form-label col-sm-2">Unit Price (Sell)<span class="asterisk">*</span></label>
        <div class="col-sm-9">
            <input type="text" asp-for="ProductModel.UnitPrice" required class="form-control" maxlength="7" />
            <div class="invalid-feedback">Please enter a valid unit price.</div>
        </div>
    </div>

    <div class="row mb-3">
        <label for="purchasePrice" class="form-label col-sm-2">Purchase Price (Buy)</label>
        <div class="col-sm-9">
            <input type="text" asp-for="ProductModel.PurchasePrice" class="form-control" maxlength="7" />
            <small class="text-muted">Harga beli dari supplier. Digunakan untuk Purchase Order.</small>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="ProductModel.LowStockThreshold" class="form-label col-sm-2">Low Stock Threshold</label>
        <div class="col-sm-9">
            <input type="number" asp-for="ProductModel.LowStockThreshold" class="form-control" min="0" placeholder="e.g. 10" />
            <small class="text-muted">Alert will appear when stock falls to or below this value. Leave empty to use default (5).</small>
        </div>
    </div>

    <div class="row mb-3">
        <label class="form-label col-sm-2">Discount</label>
        <div class="col-sm-9">
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="chkHasDiscount" asp-for="ProductModel.HasDiscount" />
                <label class="form-check-label" for="chkHasDiscount">Enable discount for this product</label>
            </div>
            <div id="discountPercentWrap" style="display:none;">
                <div class="input-group" style="max-width:200px">
                    <input type="number" asp-for="ProductModel.DiscountPercentage" class="form-control" id="inputDiscountPercent" min="0" max="100" step="0.01" placeholder="0" />
                    <span class="input-group-text">%</span>
                </div>
                <small class="text-muted">Discount percentage applied at Point of Sale.</small>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="ProductModel.SupplierID" class="form-label col-sm-2">Supplier<span class="asterisk">*</span></label>
        <div class="col-sm-9">
            <select asp-for="ProductModel.SupplierID" id="comboBoxSupplier" required class="form-control">
            </select>
            <div class="invalid-feedback">Please select a valid supplier.</div>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="ProductModel.CategoryID" class="form-label col-sm-2">Category<span class="asterisk">*</span></label>
        <div class="col-sm-9">
            <select asp-for="ProductModel.CategoryID" id="comboBoxCategory" required class="form-control"></select>
            <div class="invalid-feedback">Please select a valid category.</div>
        </div>
        <div class="col-sm-1">
            <button type="button" id="buttonAddCategory" class="btn btn-primary">Add</button>
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="ProductModel.UnitID" class="form-label col-sm-2">Unit<span class="asterisk">*</span></label>
        <div class="col-sm-9">
            <select required id="comboBoxUnit" asp-for="ProductModel.UnitID" class="form-control"></select>
            <div class="invalid-feedback">Please select a valid unit.</div>
        </div>
        <div class="col-sm-1">
            <button type="button" id="buttonAddUnit" class="btn btn-primary">Add</button>
        </div>
    </div>
</form>


<script>
    var categoryID = @Html.Raw(Json.Serialize(categoryID));
    var supplierID = @Html.Raw(Json.Serialize(supplierID));
    var unitID = @Html.Raw(Json.Serialize(unitID));

    (function () {
        var $chk = $('#chkHasDiscount'), $wrap = $('#discountPercentWrap');
        function toggle() { $wrap.toggle($chk.is(':checked')); if (!$chk.is(':checked')) $('#inputDiscountPercent').val(0); }
        $chk.on('change', toggle);
        toggle();
    })();
</script>