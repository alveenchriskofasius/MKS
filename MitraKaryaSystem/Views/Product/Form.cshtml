@model ProductViewModel
@{
    ViewData["Title"] = "Product Form";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-box-open fa-lg"></i>
                <h5 class="mb-0">Product Form</h5>
            </div>
        </div>
        <div class="card-body" id="productBodyCard">
            <partial model="@Model" name="_FormProduct" />
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="button" id="buttonSave" class="btn btn-primary">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="display: none;"></span>
                <i class="fa fa-save me-1"></i> Save
            </button>
            <a asp-action="Index" asp-controller="Product" class="btn btn-secondary"><i class="fa fa-arrow-left me-1"></i> Back</a>
        </div>
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog  modal-xl">
        <div class="modal-content">
            <div class="modal-header mks-modal-header">
                <h5 class="modal-title"><i class="fa fa-tags me-2"></i>Category Information</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="categoryBodyModal">
                <partial model=@Model.CategoryModel name="_TableCategory" />

            </div>
            <div class="modal-footer">
                <button type="button" id="buttonCloseCategory" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="buttonSaveCategory" class="btn btn-primary">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="display: none;"></span>
                    Save
                </button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="unitModal" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog  modal-xl">
        <div class="modal-content">
            <div class="modal-header mks-modal-header">
                <h5 class="modal-title"><i class="fa fa-ruler me-2"></i>Unit Information</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="unitBodyModal">
                <partial model=@Model.UnitModel name="_TableUnit" />
            </div>
            <div class="modal-footer">
                <button type="button" id="buttonCloseUnit" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="buttonSaveUnit" class="btn btn-primary">
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="display: none;"></span>
                    Save
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/Product/Form.js" asp-append-version="true"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
}