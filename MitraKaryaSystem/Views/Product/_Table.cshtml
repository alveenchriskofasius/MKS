<div class="col-12 fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-cubes-stacked fa-lg"></i>
                <h5 class="mb-0">Products</h5>
            </div>
            <a class="btn btn-sm btn-outline-light" asp-action="Form" asp-controller="Product" id="buttonAdd"><i class="fa-solid fa-plus"></i> Add Product</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover" width="100%" id="tableProduct">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Unit</th>
                            <th class="text-end">Price</th>
                            <th class="text-end">Stock</th>
                            <th>Supplier</th>
                            <th class="text-center" style="width:120px">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
