@{
    ViewData["Title"] = "Marketplace Orders";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-store fa-lg"></i>
                <h5 class="mb-0">Marketplace Orders</h5>
            </div>
            <div class="d-flex gap-2">
                <button type="button" id="btnRefresh" class="btn btn-sm btn-outline-light">
                    <i class="fa-solid fa-arrows-rotate"></i> Refresh
                </button>
            </div>
        </div>
        <div class="card-body">
            <!-- Filters -->
            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                <div>
                    <label class="form-label small fw-semibold mb-0">Status</label>
                    <select id="moStatusFilter" class="form-select form-select-sm" style="width:auto">
                        <option value="">All</option>
                        <option value="1">Draft (Belum Bayar)</option>
                        <option value="2">Paid</option>
                        <option value="9">Cancelled</option>
                    </select>
                </div>
            </div>

            <!-- Orders table -->
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle" id="tableMO" width="100%">
                    <thead>
                        <tr>
                            <th>No</th>
                            <th>Date</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Delivery</th>
                            <th>Customer</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Detail Modal -->
<div class="modal fade" id="moDetailModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header mks-modal-header">
                <h5 class="modal-title"><i class="fa fa-store me-2"></i>Order Detail</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="moDetailBody">
                <div class="text-center p-4"><div class="spinner-border"></div></div>
            </div>
            <div class="modal-footer" id="moDetailFooter">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/MarketplaceOrder.js" asp-append-version="true"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
}
