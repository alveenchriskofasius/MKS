@{
    ViewData["Title"] = "Payment Out";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-money-bill-transfer fa-lg"></i>
                <h5 class="mb-0">Payment Out</h5>
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Supplier</label>
                    <select id="selectSupplier" class="form-select"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Purchase Order</label>
                    <select id="selectPO" class="form-select"></select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button id="btnNewPaymentOut" class="btn btn-primary ms-auto"><i class="fa fa-plus me-1"></i> New Payment</button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle" id="tablePaymentOut" style="width:100%">
                    <thead class="table-light"><tr><th>No</th><th>Date</th><th>Supplier</th><th class="text-end">Amount</th><th>Method</th><th>Type</th><th>Status</th><th style="width:80px"></th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* shared modal *@
<partial name="_PaymentOutModal" />

@section Scripts {
    <script src="~/js/Common.js"></script>
    <script src="~/js/PaymentOut.js"></script>
    <script>
        $(document).ready(function(){
            function normalizeList(resp){
                if(!resp) return [];
                if(Array.isArray(resp)) return resp;
                if(resp.result && Array.isArray(resp.result)) return resp.result;
                if(resp.data && Array.isArray(resp.data)) return resp.data;
                return [];
            }

            // Try multiple endpoints until we get suppliers. Use async AJAX to avoid synchronous blocking.
            (function loadSuppliers(){
                var endpoints = ['/PaymentOut/GetSupplierList','/Product/GetSupplierList','/Customer/GetList'];
                var $select = $('#selectSupplier');
                $select.html('');
                $select.append($('<option>').val('').text('Loading...'));

                var tryIndex = 0;
                function tryNext(){
                    if(tryIndex >= endpoints.length){
                        // no data found
                        $select.html('');
                        $select.append($('<option>').val('').text('Select supplier'));
                        return;
                    }
                    var url = endpoints[tryIndex++];
                    $.ajax({
                        url: url,
                        method: 'GET',
                        dataType: 'json'
                    }).done(function(resp){
                        var list = normalizeList(resp);
                        if(list && list.length>0){
                            $select.html('');
                            $select.append($('<option>').val('').text('Select supplier'));
                            list.forEach(function(s){
                                var id = s.id || s.ID || s.Id;
                                var name = s.supplierName || s.SupplierName || s.name || s.Name || '-';
                                $select.append($('<option>').val(id).text(name));
                            });
                        } else {
                            tryNext();
                        }
                    }).fail(function(){
                        tryNext();
                    });
                }
                tryNext();
            })();

            $('#selectSupplier').on('change', function(){
                const supId = $(this).val();
                const $po = $('#selectPO');
                $po.html('');
                $po.append($('<option>').val('').text('Select PO'));
                if(!supId) return;

                // show loading option while fetching
                $po.find('option').remove();
                $po.append($('<option>').val('').text('Loading...'));

                // fetch POs for supplier (try query string first for compatibility)
                var url = '/PurchaseOrder/ListBySupplier?supplierId=' + encodeURIComponent(supId);
                $.get(url, function(list){
                    var data = normalizeList(list);
                    $po.html('');
                    $po.append($('<option>').val('').text('Select PO'));
                    if(!data || data.length === 0){
                        $po.append($('<option>').val('').text('No Purchase Orders'));
                        return;
                    }
                    data.forEach(function(po){
                        var id = po.id || po.ID || po.Id;
                        var no = po.no || po.No || po.noValue || '';
                        $po.append($('<option>').val(id).text(no));
                    });

                    // if a recent PO was saved and matches this supplier, select it
                    try{
                        if(window.lastSavedPO && window.lastSavedPO.supplierID && String(window.lastSavedPO.supplierID) === String(supId)){
                            $po.val(String(window.lastSavedPO.id));
                        }
                    }catch(e){ console.warn('selectPO auto-select failed', e); }
                }).fail(function(){
                    $po.html('');
                    $po.append($('<option>').val('').text('Failed load'));
                });
            });

            // listen for purchase order saved from PO page and preselect supplier/PO
            $(document).on('purchaseorder:saved', function(e, payload){
                try{
                    if(!payload) return;
                    if(payload.supplierID){ $('#selectSupplier').val(String(payload.supplierID)).trigger('change'); }
                    window.lastSavedPO = payload; // keep for later
                }catch(ex){ console.warn('purchaseorder:saved handling', ex); }
            });

            function loadList(){
                $.get('/PaymentOut/List', function(list){
                    const data = list && list.result ? list.result : list || [];
                    let rows = data.map(p => {
                        const canEdit = (p.statusID || p.StatusID) != 2;
                        const editBtn = canEdit ? `<button class='btn btn-sm btn-outline-primary edit' data-id='${p.id||p.ID}' title='Edit'><i class='fa fa-pencil'></i></button>` : '';
                        const printBtn = `<button class='btn btn-sm btn-outline-secondary po-print-row' data-no='${p.no||""}' data-date='${p.date||""}' data-supplier='${(p.supplierName||"").replace(/'/g,"&#39;")}' data-amount='${p.amount||0}' data-method='${p.method||""}' data-type='${p.type||""}'><i class='fa fa-print'></i></button>`;
                        return `<tr><td>${p.no||''}</td><td>${Common.Format.Date(p.date)}</td><td>${p.supplierName||''}</td><td class='text-end'>${(Number(p.amount||0)).toFixed(2)}</td><td>${p.method||''}</td><td>${p.type||''}</td><td>${(p.statusID==2?'<span class="badge bg-success">Submitted</span>':'<span class="badge bg-secondary">Draft</span>')}</td><td>${editBtn} ${printBtn}</td></tr>`;
                    }).join('');
                    $('#tablePaymentOut tbody').html(rows||'<tr><td colspan="8" class="text-center text-muted">No data</td></tr>');
                }).fail(()=>$('#tablePaymentOut tbody').html('<tr><td colspan="8" class="text-center text-muted">Failed load</td></tr>'));
            }

            loadList();

            $('#btnNewPaymentOut').on('click', function(){
                const supId = $('#selectSupplier').val();
                if(!supId){ toastr.info('Select supplier first'); return; }
                const supName = $('#selectSupplier option:selected').text();
                const poId = $('#selectPO').val();
                window.showPaymentOutModal(supId, supName, new Date().toISOString().slice(0,10), poId);
            });

            // refresh after save
            $(document).on('paymentout:saved', function(){ loadList(); });

            // print per-row
            $(document).on('click', '.po-print-row', function(){
                MksPrint.paymentOut({ no: $(this).data('no'), date: $(this).data('date'), supplierName: $(this).data('supplier'), amount: $(this).data('amount'), method: $(this).data('method'), type: $(this).data('type') });
            });

            // optional: delegate edit click if present
            $('#tablePaymentOut').on('click', '.edit', function(){
                const id = $(this).data('id');
                // open edit flow - if backend supports, otherwise ignore
                // try to fetch payment detail and prefill modal
                $.get('/PaymentOut/Get',{ id: id }, function(res){
                    const p = res && (res.result || res) ? (res.result || res) : null;
                    if(!p){ toastr.error('Failed to load payment'); return; }
                    const supId = p.supplierID || p.SupplierID || '';
                    const supName = p.supplierName || p.SupplierName || '';
                    window.showPaymentOutModal(supId, supName, (p.date||new Date().toISOString()).toString().substr(0,10), p.purchaseOrderID || p.PurchaseOrderID);
                    // set values after modal open
                    setTimeout(function(){
                        $('#poAmount').val((p.amount||p.Amount||0).toFixed ? (p.amount||p.Amount||0).toFixed(2) : (p.amount||p.Amount||0));
                        $('#poMethod').val(p.method||p.Method||'Cash');
                        if ($('input[name="poType"][value="' + (p.type||p.Type||'Payment') + '"]').length) $('input[name="poType"][value="' + (p.type||p.Type||'Payment') + '"]').prop('checked', true);
                    }, 250);
                }).fail(()=> toastr.error('Failed load'));
            });
        });
    </script>
}
