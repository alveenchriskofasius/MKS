@{
    ViewData["Title"] = "Driver Tasks";
}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="card-title"><b>My Delivery Tasks</b></div>
                <div>
                    <select id="filterTaskStatus" class="form-select form-select-sm">
                        <option value="">All</option>
                        <option value="2">Assigned</option>
                        <option value="3">On Route</option>
                        <option value="4">Delivered</option>
                    </select>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover" id="tableDriverTasks">
                        <thead>
                        <tr>
                            <th>DO No</th>
                            <th>SO ID</th>
                            <th>Status</th>
                            <th>Address</th>
                            <th>Action</th>
                        </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/Driver.js"></script>
}
