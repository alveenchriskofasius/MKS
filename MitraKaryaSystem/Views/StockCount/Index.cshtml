@{
    ViewData["Title"] = "Stock Count";
}
<div class="fade-slide-up" id="stockCountApp">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-clipboard-check fa-lg"></i>
                <h5 class="mb-0">Stock Count</h5>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" id="btnNew"><i class="fa fa-plus"></i> New</button>
                <button class="btn btn-sm btn-outline-light" id="btnSearch"><i class="fa fa-search"></i> Search</button>
                <button class="btn btn-sm btn-outline-light" id="btnAutoAdjust" title="Generate adjustment for differences"><i class="fa fa-magic"></i> Auto Adjust</button>
                <button class="btn btn-sm btn-warning" id="btnSave"><span class="spinner-border spinner-border-sm d-none"></span> <i class="fa fa-save"></i> Save</button>
            </div>
        </div>
        <div class="card-body">
    <div id="stockCountHeader"></div>
    <div class="card shadow-sm mt-3">
        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
            <strong class="text-muted"><i class="fa fa-boxes-stacked me-1"></i> Items</strong>
            <div class="input-group input-group-sm" style="width:320px;">
                <span class="input-group-text"><i class="fa fa-barcode"></i></span>
                <input id="scanProduct" class="form-control" placeholder="Type or scan product name" />
                <button class="btn btn-outline-primary" id="btnAddProduct"><i class="fa fa-plus"></i></button>
            </div>
        </div>
        <div class="card-body p-2">
            <table class="table table-sm table-bordered align-middle" id="tableStockCountItems" style="width:100%">
                <thead class="table-light">
                    <tr>
                        <th style="display:none;">ProductID</th>
                        <th>Product</th>
                        <th class="text-end" style="width:110px">System</th>
                        <th class="text-end" style="width:110px">Physical</th>
                        <th class="text-end" style="width:110px">Diff</th>
                        <th class="text-end" style="width:130px">Unit Price</th>
                        <th class="text-end" style="width:140px">Diff Value</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
            </table>
            <div class="text-end mt-2 pe-1">
                <span class="fw-semibold">Total Difference Value: </span>
                <span id="totalDiffValue" class="badge rounded-pill text-bg-info">0.00</span>
            </div>
        </div>
    </div>
</div>

    </div></div>
</div>
<!-- Search Modal -->
<div class="modal fade" id="searchModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header mks-modal-header"><h5 class="modal-title"><i class="fa fa-search me-2"></i>Search Stock Count</h5><button class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
      <div class="modal-body p-2">
        <table class="table table-sm table-striped" id="tableStockCountSearch" style="width:100%">
            <thead class="table-light"><tr><th>No</th><th>Date</th><th>Note</th><th>Items</th><th>Diff Value</th><th></th></tr></thead>
        </table>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script src="/js/StockCount.js"></script>
}
