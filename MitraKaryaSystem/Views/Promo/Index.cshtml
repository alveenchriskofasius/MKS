@{
    ViewData["Title"] = "Promo Management";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-percent fa-lg"></i>
                <h5 class="mb-0">Promo / Discount Management</h5>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" id="btnNewPromo" data-bs-toggle="modal" data-bs-target="#promoModal">
                    <i class="fa-solid fa-plus"></i> New Promo
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" id="tablePromo">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th class="text-center">Discount</th>
                            <th>Period</th>
                            <th>Apply To</th>
                            <th>Target</th>
                            <th class="text-center">Status</th>
                            <th>Created By</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Promo Modal -->
<div class="modal fade" id="promoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="promoModalTitle">New Promo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="promoId" value="0" />
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name <span class="asterisk">*</span></label>
                    <input type="text" class="form-control" id="promoName" placeholder="e.g. Weekend Sale" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Discount % <span class="asterisk">*</span></label>
                    <input type="number" class="form-control" id="promoDiscount" min="0.01" max="100" step="0.01" placeholder="10" />
                </div>
                <div class="row mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Start Date <span class="asterisk">*</span></label>
                        <input type="date" class="form-control" id="promoStart" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">End Date <span class="asterisk">*</span></label>
                        <input type="date" class="form-control" id="promoEnd" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Apply To</label>
                    <select class="form-select" id="promoApplyTo">
                        <option value="All">All Products</option>
                        <option value="Category">Specific Category</option>
                        <option value="Product">Specific Product</option>
                    </select>
                </div>
                <div class="mb-3 d-none" id="promoCategoryWrap">
                    <label class="form-label fw-semibold">Category</label>
                    <select class="form-select" id="promoCategory"></select>
                </div>
                <div class="mb-3 d-none" id="promoProductWrap">
                    <label class="form-label fw-semibold">Product</label>
                    <select class="form-select" id="promoProduct"></select>
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="promoActive" checked />
                    <label class="form-check-label" for="promoActive">Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSavePromo"><i class="fa fa-save me-1"></i>Save</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/Promo.js" asp-append-version="true"></script>
}
