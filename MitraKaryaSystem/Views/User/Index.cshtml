@{
    ViewData["Title"] = "User Management";
}
<style>
    /* ── User list ── */
    .user-list { list-style: none; padding: 0; margin: 0; }
    .user-list-item {
        padding: .65rem 1rem; border-radius: 8px; cursor: pointer;
        display: flex; align-items: center; gap: .75rem;
        transition: all .2s; margin-bottom: 4px; border: 1px solid transparent;
    }
    .user-list-item:hover { background: var(--mks-gray-100); }
    .user-list-item.active { background: var(--mks-primary-light); border-color: var(--mks-primary); }
    .user-avatar {
        width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: .82rem; text-transform: uppercase; flex-shrink: 0;
        background: var(--mks-primary-light); color: var(--mks-primary);
    }
    .user-list-item.active .user-avatar { background: var(--mks-primary); color: #fff; }
    .user-info .user-name { font-weight: 600; font-size: .85rem; color: var(--mks-gray-800); }
    .user-list-item.active .user-info .user-name { color: var(--mks-primary); }
    .user-info .user-email { font-size: .72rem; color: var(--mks-gray-600); }
    .user-list-item .user-status { margin-left: auto; flex-shrink: 0; }

    /* ── Role toggle in form ── */
    .role-toggle-list { display: flex; flex-wrap: wrap; gap: .5rem; }
    .role-chip {
        display: inline-flex; align-items: center; gap: .4rem; padding: .35rem .75rem;
        border: 1px solid var(--mks-gray-200); border-radius: 50rem; font-size: .8rem;
        cursor: pointer; transition: all .2s; user-select: none; color: var(--mks-gray-700);
    }
    .role-chip:hover { border-color: var(--mks-primary); background: var(--mks-primary-light); }
    .role-chip.selected { background: var(--mks-primary); color: #fff; border-color: var(--mks-primary); }
    .role-chip input { display: none; }

    .section-label { font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .5px; color: var(--mks-gray-600); }
</style>
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-users fa-lg"></i>
                <h5 class="mb-0">User Management</h5>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" id="buttonAddUser"><i class="fa fa-user-plus"></i> New User</button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="row g-0">
                <!-- Left: User list -->
                <div class="col-md-4 col-lg-3 border-end" style="min-height:480px">
                    <div class="p-3">
                        <div class="input-group input-group-sm mb-3">
                            <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                            <input type="text" class="form-control" id="userSearch" placeholder="Search users…">
                        </div>
                        <ul class="user-list" id="userList">
                            <li class="text-center text-muted py-4"><small>Loading…</small></li>
                        </ul>
                    </div>
                </div>
                <!-- Right: Form panel -->
                <div class="col-md-8 col-lg-9">
                    <div id="userFormPanel" class="p-3">
                        <div class="empty-state" id="userEmptyState">
                            <i class="fa fa-users"></i>
                            <p>Select a user to edit or create a new one</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/User.js" asp-append-version="true"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
}