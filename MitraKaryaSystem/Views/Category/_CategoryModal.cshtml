@model CategoryModel
<form id="categoryForm">
    <input asp-for="@Model.ID" type="text" hidden />
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="@Model.CategoryName" class="form-label fw-semibold small">Category Name <span class="text-danger">*</span></label>
            <input asp-for="@Model.CategoryName" type="text" required class="form-control" placeholder="Enter category name" />
            <div class="invalid-feedback">Please enter a category name.</div>
        </div>
    </div>
</form>
