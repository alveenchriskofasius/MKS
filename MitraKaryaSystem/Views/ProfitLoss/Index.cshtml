@{
    ViewData["Title"] = "Profit & Loss";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-chart-pie fa-lg"></i>
                <h5 class="mb-0">Profit & Loss Report</h5>
            </div>
        </div>
        <div class="card-body">
            <!-- Period Filter -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">From</label>
                            <input type="date" class="form-control form-control-sm" id="plFrom" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-semibold mb-1">To</label>
                            <input type="date" class="form-control form-control-sm" id="plTo" />
                        </div>
                        <div class="col-md-3 d-flex gap-2">
                            <button class="btn btn-sm btn-primary" id="btnGenerate"><i class="fa fa-sync me-1"></i>Generate</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm" style="background:linear-gradient(135deg,#dcfce7 0%,#bbf7d0 100%)">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:52px;height:52px;background:#16a34a;color:#fff">
                                    <i class="fa fa-arrow-trend-up fa-lg"></i>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">Revenue</div>
                                    <div class="fw-bold fs-5" id="plRevenue" style="color:#16a34a">Rp 0</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm" style="background:linear-gradient(135deg,#fee2e2 0%,#fecaca 100%)">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:52px;height:52px;background:#dc2626;color:#fff">
                                    <i class="fa fa-arrow-trend-down fa-lg"></i>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">Total Cost (COGS + Expense)</div>
                                    <div class="fw-bold fs-5" id="plCost" style="color:#dc2626">Rp 0</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm" id="plNetCard" style="background:linear-gradient(135deg,#e0e7ff 0%,#c7d2fe 100%)">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" id="plNetIcon" style="width:52px;height:52px;background:#4f46e5;color:#fff">
                                    <i class="fa fa-scale-balanced fa-lg"></i>
                                </div>
                                <div>
                                    <div class="text-muted small fw-semibold">Net Profit</div>
                                    <div class="fw-bold fs-5" id="plNet" style="color:#4f46e5">Rp 0</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- P&L Statement -->
            <div class="card border-0 shadow-sm">
                <div class="card-header fw-semibold"><i class="fa fa-list-check me-2"></i>Profit & Loss Statement</div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm mb-0" id="plTable">
                            <thead class="table-light">
                                <tr><th>Description</th><th class="text-end" style="width:200px">Amount</th></tr>
                            </thead>
                            <tbody id="plBody">
                                <tr><td colspan="2" class="text-center text-muted py-4">Click "Generate" to load report</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/ProfitLoss.js" asp-append-version="true"></script>
}
