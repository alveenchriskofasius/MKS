@{
    ViewData["Title"] = "Delivery Order";
}
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Delivery Orders</h5>
    <div class="d-flex gap-2">
      <select id="filterDOStatus" class="form-select form-select-sm" style="width:180px">
        <option value="">-- All Status --</option>
        <option value="1">Pending</option>
        <option value="2">Assigned</option>
        <option value="3">Out For Delivery</option>
        <option value="4">Delivered</option>
        <option value="5">Canceled</option>
      </select>
      <button id="btnRefreshDO" class="btn btn-sm btn-outline-primary"><i class="fa fa-rotate"></i> Refresh</button>
    </div>
  </div>
  <div class="card-body">
    <table id="tableDeliveryOrder" class="table table-sm table-bordered table-striped w-100">
      <thead>
        <tr>
          <th>No</th>
          <th>Sales Order</th>
          <th>Status</th>
          <th>Driver</th>
          <th>Address</th>
          <th style="width:90px">Action</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>
</div>
@section Scripts {
  <script src="~/js/DeliveryOrder.js" asp-append-version="true"></script>
}
