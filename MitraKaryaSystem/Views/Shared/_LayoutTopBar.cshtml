<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mitra Karya</title>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link href="https://cdn.datatables.net/v/bs5/dt-1.13.7/r-2.5.0/sl-1.7.0/datatables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.css">
    <link rel="stylesheet" href="~/css/site-custom.css" asp-append-version="true" />
    <style>
        body { background: #f4f6f9; margin: 0; }
        .topbar-navbar { background: #1e293b; padding: .5rem 1.25rem; }
        .topbar-navbar .brand { color: #fff; font-weight: 700; font-size: 1.1rem; text-decoration: none; }
        .topbar-navbar .brand img { width: 32px; height: 32px; border-radius: 50%; margin-right: .5rem; }
        .topbar-navbar .user-info { color: #94a3b8; font-size: .85rem; }
        .topbar-navbar .user-info .name { color: #fff; font-weight: 600; }
        .topbar-nav a { color: #94a3b8; text-decoration: none; font-size: .85rem; padding: .35rem .75rem; border-radius: .375rem; transition: all .15s; }
        .topbar-nav a:hover { color: #fff; background: rgba(255,255,255,.1); }
        .topbar-nav a.active { color: #fff; background: #3b82f6; }
        .topbar-content { padding: 1rem; }
    </style>
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var userPerms = User?.Claims?.Where(c => string.Equals(c.Type, "Permission", StringComparison.OrdinalIgnoreCase)).Select(c => c.Value).ToList() ?? new List<string>();
        var userRole = User?.Claims?.FirstOrDefault(c => string.Equals(c.Type, System.Security.Claims.ClaimTypes.Role, StringComparison.OrdinalIgnoreCase))?.Value ?? "";
        bool isKasir = string.Equals(userRole, "Kasir", StringComparison.OrdinalIgnoreCase);
        bool isDriver = string.Equals(userRole, "Driver", StringComparison.OrdinalIgnoreCase);
    }
    <nav class="topbar-navbar d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <a class="brand d-flex align-items-center" href="/">
                <img src="~/dist/image/logo.jpg" alt="Logo">
                <span>Mitra Karya</span>
            </a>
            <div class="topbar-nav d-flex align-items-center gap-1">
                <a href="/" class="@(currentController == "Home" ? "active" : "")">
                    <i class="fa fa-tachometer-alt me-1"></i>Dashboard
                </a>
                @if (isKasir)
                {
                    <a href="/Pos" class="@(currentController == "Pos" ? "active" : "")">
                        <i class="fa fa-cash-register me-1"></i>POS
                    </a>
                    if (userPerms.Any(p => string.Equals(p, "Sales Order", StringComparison.OrdinalIgnoreCase)))
                    {
                        <a href="/SalesOrder" class="@(currentController == "SalesOrder" ? "active" : "")">
                            <i class="fa fa-file-invoice me-1"></i>Sales Order
                        </a>
                    }
                }
                @if (isDriver)
                {
                    if (userPerms.Any(p => string.Equals(p, "Delivery Order", StringComparison.OrdinalIgnoreCase)))
                    {
                        <a href="/DeliveryOrder" class="@(currentController == "DeliveryOrder" ? "active" : "")">
                            <i class="fa fa-truck-fast me-1"></i>Delivery Order
                        </a>
                    }
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="user-info">
                <i class="fa fa-user-circle me-1"></i>
                <span class="name">@User.Identity?.Name</span>
            </span>
            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-light btn-sm" title="Logout">
                <i class="fa fa-sign-out-alt me-1"></i> Logout
            </a>
        </div>
    </nav>

    <div class="topbar-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/bs5/dt-1.13.7/r-2.5.0/sl-1.7.0/datatables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    @{
        var userPermissions = User?.Claims?.Where(c => string.Equals(c.Type, "Permission", StringComparison.OrdinalIgnoreCase)).Select(c => c.Value).ToList() ?? new List<string>();
    }
    <script>window.__userPermissions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userPermissions));</script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
    <script src="~/js/shared/DataTable.js" asp-append-version="true"></script>
    <script src="~/js/shared/MksStoreProfile.js" asp-append-version="true"></script>
    <script src="~/js/shared/Print.js" asp-append-version="true"></script>
    <script src="~/js/shared/ProductSearch.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
