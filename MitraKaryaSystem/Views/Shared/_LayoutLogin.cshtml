<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - MitraKaryaSystem</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
	<style>
		*{margin:0;padding:0;box-sizing:border-box;}
		body{min-height:100vh;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 50%,#2563eb 100%);font-family:'Segoe UI',system-ui,sans-serif;}
		.login-wrapper{display:flex;width:900px;max-width:95vw;min-height:520px;border-radius:20px;overflow:hidden;box-shadow:0 25px 60px rgba(0,0,0,.35);}
		.login-brand{flex:1;background:linear-gradient(135deg,#1e3a5f 0%,#2563eb 100%);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2.5rem;color:#fff;position:relative;overflow:hidden;}
		.login-brand::before{content:'';position:absolute;width:300px;height:300px;border-radius:50%;background:rgba(255,255,255,.05);top:-80px;right:-80px;}
		.login-brand::after{content:'';position:absolute;width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,.04);bottom:-60px;left:-40px;}
		.login-brand .brand-logo{width:90px;height:90px;border-radius:50%;border:3px solid rgba(255,255,255,.3);object-fit:cover;margin-bottom:1.25rem;box-shadow:0 8px 24px rgba(0,0,0,.2);}
		.login-brand h2{font-weight:700;font-size:1.5rem;letter-spacing:.5px;margin-bottom:.5rem;z-index:1;}
		.login-brand p{font-size:.85rem;opacity:.7;text-align:center;z-index:1;max-width:220px;line-height:1.5;}
		.login-form{flex:1;background:#fff;display:flex;flex-direction:column;justify-content:center;padding:3rem 2.5rem;}
		.login-form h3{font-weight:700;color:#1e293b;margin-bottom:.25rem;}
		.login-form .subtitle{color:#64748b;font-size:.85rem;margin-bottom:2rem;}
		.login-form .form-floating{margin-bottom:1.1rem;}
		.login-form .form-floating .form-control{border-radius:10px;border:1.5px solid #e2e8f0;height:52px;font-size:.9rem;transition:all .2s;}
		.login-form .form-floating .form-control:focus{border-color:#2563eb;box-shadow:0 0 0 4px rgba(37,99,235,.1);}
		.login-form .form-floating label{color:#94a3b8;font-size:.85rem;}
		.login-form .btn-login{height:48px;border-radius:12px;font-weight:600;font-size:.95rem;letter-spacing:.3px;background:linear-gradient(135deg,#1e3a5f,#2563eb);border:none;color:#fff;transition:all .25s;}
		.login-form .btn-login:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(37,99,235,.35);}
		.login-footer{text-align:center;margin-top:2rem;font-size:.75rem;color:#94a3b8;}
		@@media(max-width:768px){.login-brand{display:none;}.login-wrapper{min-height:auto;border-radius:16px;}.login-form{padding:2rem 1.5rem;}}
	</style>
</head>
<body>
	<div class="login-wrapper">
		<div class="login-brand">
			<img src="/dist/image/logo.jpg" class="brand-logo" alt="Logo" />
			<h2>Mitra Karya System</h2>
			<p>Inventory & Sales Management Platform</p>
		</div>
		<div class="login-form">
			@RenderBody()
			<div class="login-footer">&copy; @DateTime.Now.Year Mitra Karya System</div>
		</div>
	</div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
