<div class="modal fade" id="paymentInModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fa fa-cash-register"></i> Add Payment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-2">
          <div class="col-6">
            <label class="form-label small">Date</label>
            <input type="date" class="form-control form-control-sm" id="piDate" />
          </div>
          <div class="col-6">
            <label class="form-label small">Customer</label>
            <div class="form-control form-control-sm" id="piCustomerName">-</div>
            <input type="hidden" id="piCustomerId" />
          </div>
          <div class="col-6">
            <label class="form-label small">Method</label>
            <select id="piMethod" class="form-select form-select-sm">
              <option>Cash</option>
              <option>Transfer</option>
              <option>QRIS</option>
            </select>
          </div>
          <div class="col-6">
            <label class="form-label small">Type</label>
            <div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="piType" id="piTypeDP" value="DP" checked>
                <label class="form-check-label" for="piTypeDP">DP</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="piType" id="piTypePelunasan" value="Pelunasan">
                <label class="form-check-label" for="piTypePelunasan">Pelunasan</label>
              </div>
              <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="piType" id="piTypeFull" value="Full">
                <label class="form-check-label" for="piTypeFull">Full</label>
              </div>
            </div>
          </div>
          <div class="col-12">
            <label class="form-label small">Amount</label>
            <input type="number" class="form-control form-control-sm" id="piAmount" min="0" step="0.01" />
          </div>
          <div class="col-12">
            <label class="form-label small">Note</label>
            <textarea id="piNote" class="form-control form-control-sm" rows="2"></textarea>
          </div>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="piSubmit" checked />
              <label class="form-check-label" for="piSubmit">Submit now</label>
            </div>
          </div>
          <input type="hidden" id="piSOId" />
          <input type="hidden" id="piInvoiceId" />
        </div>
        <hr/>
        <div>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="fw-bold">Payment History</div>
            <div class="small text-muted">Latest first</div>
          </div>
          <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0">
              <thead class="table-light"><tr><th>No</th><th>Date</th><th>Method</th><th class="text-end">Amount</th><th>Type</th><th>Status</th></tr></thead>
              <tbody id="piHistoryBody"><tr><td colspan="6" class="text-center text-muted small">No payments</td></tr></tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button class="btn btn-primary" id="btnPaymentSave"><span class="spinner-border spinner-border-sm d-none"></span> Save</button>
      </div>
    </div>
  </div>
</div>
