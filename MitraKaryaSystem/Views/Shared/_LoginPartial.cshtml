@using System.Security.Principal
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<ul class="navbar-nav ms-auto d-flex flex-row align-items-center gap-2">
    <li class="nav-item dropdown">
        <a class="nav-link px-2 position-relative" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Notifications" id="navAlertBell">
            <i class="fas fa-bell"></i>
            <span id="alertBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display:none;font-size:.65rem;"></span>
        </a>
        <div class="dropdown-menu dropdown-menu-end shadow-lg p-0" style="width:380px;max-height:480px;overflow:hidden;" id="alertDropdown">
            <div class="d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-light">
                <span class="fw-semibold"><i class="fa fa-bell me-1"></i> Notifications</span>
                <a href="/Notification" class="small text-decoration-none">View All</a>
            </div>
            <div id="alertDropdownBody" style="max-height:400px;overflow-y:auto;">
                <div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm"></div></div>
            </div>
        </div>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle px-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow">
            <li>
                <a class="dropdown-item" asp-controller="Auth" asp-action="Profile">
                    <i class="fas fa-cog me-1"></i> Pengaturan
                </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                    <i class="fas fa-sign-out-alt me-1"></i> Keluar
                </a>
            </li>
        </ul>
    </li>
</ul>
