<!-- Sidebar -->
@using System.Security.Claims
@{
    // collect raw permission claims
    var rawPermissions = User?.Claims?.Where(c => string.Equals(c.Type, "Permission", StringComparison.OrdinalIgnoreCase)).Select(c => c.Value).ToList() ?? new List<string>();
    // normalized permissions (remove spaces, case-insensitive) for consistent comparison
    var permissionsNormalized = new HashSet<string>(rawPermissions.Select(p => (p ?? string.Empty).Replace(" ", "")), StringComparer.OrdinalIgnoreCase);

    bool CanSee(string perm)
    {
        // Home (dashboard) is visible to everyone
        if (string.Equals(perm, "Home", StringComparison.OrdinalIgnoreCase)) return true;
        var key = (perm ?? string.Empty).Replace(" ", "");
        return permissionsNormalized.Contains(key);
    }
}
