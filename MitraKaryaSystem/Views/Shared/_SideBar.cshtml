<!-- Sidebar -->
@using System.Security.Claims
@{
    // collect raw permission claims
    var rawPermissions = User?.Claims?.Where(c => string.Equals(c.Type, "Permission", StringComparison.OrdinalIgnoreCase)).Select(c => c.Value).ToList() ?? new List<string>();
    // normalized permissions (remove spaces, case-insensitive) for consistent comparison
    var permissionsNormalized = new HashSet<string>(rawPermissions.Select(p => (p ?? string.Empty).Replace(" ", "")), StringComparer.OrdinalIgnoreCase);

    bool CanSee(string perm)
    {
        // Home (dashboard) is visible to everyone
        if (string.Equals(perm, "Home", StringComparison.OrdinalIgnoreCase)) return true;
        var key = (perm ?? string.Empty).Replace(" ", "");
        return permissionsNormalized.Contains(key);
    }
}
<div class="sidebar">
    <!-- Sidebar Menu -->
    <nav class="mt-2">
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
            <!-- Overview -->
            <li class="nav-section">Overview</li>
            <li class="nav-item">
                <a asp-action="Index" asp-controller="Home" class="nav-link">
                    <i class="fa-solid fa-chart-line"></i>
                    <p>Dashboard</p>
                </a>
            </li>
            @if(CanSee("Point of Sale"))
            {
                <li class="nav-item">
                    <a asp-action="Index" asp-controller="Pos" class="nav-link">
                        <i class="fa-solid fa-cash-register"></i>
                        <p>Point of Sale</p>
                    </a>
                </li>
            }

            @if(CanSee("Sales Order") || CanSee("Sales Invoice") || CanSee("Delivery Order") || CanSee("Sales Return") || CanSee("Payment In"))
            {
                <!-- Sales -->
                <li class="nav-section">Sales</li>
                @if(CanSee("Sales Order"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="SalesOrder" class="nav-link">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                            <p>Sales Order</p>
                        </a>
                    </li>
                }
                @if(CanSee("Sales Invoice"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="SalesInvoice" class="nav-link">
                            <i class="fa-solid fa-file-invoice"></i>
                            <p>Sales Invoice</p>
                        </a>
                    </li>
                }
                @if(CanSee("Delivery Order"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="DeliveryOrder" class="nav-link">
                            <i class="fa-solid fa-truck-fast"></i>
                            <p>Delivery Order</p>
                        </a>
                    </li>
                }
                @if(CanSee("Sales Return"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="SalesReturn" class="nav-link">
                            <i class="fa-solid fa-rotate-left"></i>
                            <p>Sales Return</p>
                        </a>
                    </li>
                }
                @if(CanSee("Payment In"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="PaymentIn" class="nav-link">
                            <i class="fa-solid fa-hand-holding-dollar"></i>
                            <p>Payment In</p>
                        </a>
                    </li>
                }
            }

            @if(CanSee("Purchase Order") || CanSee("Purchase Return") || CanSee("Payment Out"))
            {
                <!-- Purchasing -->
                <li class="nav-section">Purchasing</li>
                @if(CanSee("Purchase Order"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="PurchaseOrder" class="nav-link">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <p>Purchase Order</p>
                        </a>
                    </li>
                }
                @if(CanSee("Purchase Return"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="PurchaseReturn" class="nav-link">
                            <i class="fa-solid fa-rotate-right"></i>
                            <p>Purchase Return</p>
                        </a>
                    </li>
                }
                @if(CanSee("Payment Out"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="PaymentOut" class="nav-link">
                            <i class="fa-solid fa-money-bill-wave"></i>
                            <p>Payment Out</p>
                        </a>
                    </li>
                }
            }

            @if(CanSee("Product") || CanSee("Stock In") || CanSee("Stock Count"))
            {
                <!-- Inventory -->
                <li class="nav-section">Inventory</li>
                @if(CanSee("Product"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Product" class="nav-link">
                            <i class="fa-solid fa-cubes-stacked"></i>
                            <p>Products</p>
                        </a>
                    </li>
                }
                @if(CanSee("Stock In"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="StockIn" class="nav-link">
                            <i class="fa-solid fa-boxes-stacked"></i>
                            <p>Stock In</p>
                        </a>
                    </li>
                }
                @if(CanSee("Stock Count"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="StockCount" class="nav-link">
                            <i class="fa-solid fa-clipboard-check"></i>
                            <p>Stock Count</p>
                        </a>
                    </li>
                }
                @if(CanSee("Product"))
                {
                    <li class="nav-item">
                        <a asp-action="Low" asp-controller="Stock" class="nav-link">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <p>Low Stock</p>
                        </a>
                    </li>
                }
            }

            @if(CanSee("Customer") || CanSee("Driver"))
            {
                <!-- Master Data -->
                <li class="nav-section">Master Data</li>
                @if(CanSee("Customer"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Customer" class="nav-link">
                            <i class="fa-solid fa-user-group"></i>
                            <p>Customers</p>
                        </a>
                    </li>
                }
                @if(CanSee("Driver"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Driver" class="nav-link">
                            <i class="fa-solid fa-id-badge"></i>
                            <p>Drivers</p>
                        </a>
                    </li>
                }
            }

            @if(CanSee("User") || CanSee("Role") || CanSee("Audit Log"))
            {
                <!-- Administration -->
                <li class="nav-section">Administration</li>
                @if(CanSee("User"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="User" class="nav-link">
                            <i class="fa-solid fa-users"></i>
                            <p>Users</p>
                        </a>
                    </li>
                }
                @if(CanSee("Role"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="Role" class="nav-link">
                            <i class="fa-solid fa-shield-halved"></i>
                            <p>Roles &amp; Permissions</p>
                        </a>
                    </li>
                }
                @if(CanSee("Audit Log"))
                {
                    <li class="nav-item">
                        <a asp-action="Index" asp-controller="AuditLog" class="nav-link">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            <p>Audit Log</p>
                        </a>
                    </li>
                }
            }
        </ul>
    </nav>
    <!-- /.sidebar-menu -->
</div>
<!-- /.sidebar -->