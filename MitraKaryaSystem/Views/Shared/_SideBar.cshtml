<!-- Sidebar -->
@using System.Security.Claims
@{
    // collect raw permission claims
    var rawPermissions = User?.Claims?.Where(c => string.Equals(c.Type, "Permission", StringComparison.OrdinalIgnoreCase)).Select(c => c.Value).ToList() ?? new List<string>();
    // normalized permissions (remove spaces, case-insensitive) for consistent comparison
    var permissionsNormalized = new HashSet<string>(rawPermissions.Select(p => (p ?? string.Empty).Replace(" ", "")), StringComparer.OrdinalIgnoreCase);

    bool isDriverOnly = permissionsNormalized.Count == 1 && permissionsNormalized.Contains("Driver");

    string? Has(string perm)
    {
        // Home (dashboard) should be visible to everyone
        if (string.Equals(perm, "Home", StringComparison.OrdinalIgnoreCase)) return null;
        // If user is driver-only, hide all other menu items
        if (isDriverOnly) return "d-none";
        var key = (perm ?? string.Empty).Replace(" ", "");
        return permissionsNormalized.Contains(key) ? null : "d-none";
    }
}
<div class="sidebar">
    <!-- Sidebar Menu -->
    <nav class="mt-2">
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
            <!-- Overview -->
            <li class="nav-section">Overview</li>
            <li class="nav-item">
                <a asp-action="Index" asp-controller="Home" class="nav-link @Has("Home")">
                    <i class="fa-solid fa-chart-line"></i>
                    <p>Dashboard</p>
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Index" asp-controller="Pos" class="nav-link @Has("Point of Sale")">
                    <i class="fa-solid fa-cash-register"></i>
                    <p>Point of Sale</p>
                </a>
            </li>

            <!-- Sales -->
