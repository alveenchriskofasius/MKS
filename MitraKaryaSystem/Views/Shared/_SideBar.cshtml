<!-- Sidebar -->
@using System.Security.Claims
@{
    // collect permission claims (case-insensitive)
    var permissions = User?.Claims?.Where(c => string.Equals(c.Type, "Permission", StringComparison.OrdinalIgnoreCase)).Select(c => c.Value).ToList() ?? new List<string>();
    bool isDriverOnly = permissions.Count == 1 && string.Equals(permissions[0], "Driver", StringComparison.OrdinalIgnoreCase);

    string? Has(string perm)
    {
        // Home (dashboard) should be visible to everyone
        if (string.Equals(perm, "Home", StringComparison.OrdinalIgnoreCase)) return null;
        // If user is driver-only, hide all other menu items
        if (isDriverOnly) return "d-none";
        return User?.Claims?.Any(c => c.Type == "Permission" && string.Equals(c.Value, perm, StringComparison.OrdinalIgnoreCase)) == true ? null : "d-none";
    }
}
<div class="sidebar">
    <!-- Sidebar Menu -->
    <nav class="mt-2">
        <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
            <li class="nav-item">
                <a asp-action="Index" asp-controller="User" class="nav-link @Has("User")">
                    <i class="fa-solid fa-users"></i>
                    <p>
                        User
                    </p>
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Index" asp-controller="Role" class="nav-link @Has("Role")">
                    <i class="fa-solid fa-wrench"></i>
                    <p>
                        Role
                    </p>
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Index" asp-controller="Customer" class="nav-link @Has("Customer")">
                    <i class="fa-solid fa-user"></i>
                    <p>
                        Customer
                    </p>
                </a>
            </li>
            <li class="nav-item">
                <a asp-action="Index" asp-controller="Product" class="nav-link @Has("Product")">
