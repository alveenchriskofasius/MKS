@{
    ViewData["Title"] = "Halaman Tidak Ditemukan";
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 – Halaman Tidak Ditemukan</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #f4f6f9;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }
        .notfound-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 4px 24px rgba(0,0,0,.08);
            padding: 3rem 2.5rem;
            text-align: center;
            max-width: 460px;
            width: 100%;
        }
        .notfound-code {
            font-size: 6rem;
            font-weight: 800;
            color: #3490dc;
            line-height: 1;
        }
        footer {
            margin-top: 2rem;
            color: #aaa;
            font-size: .8rem;
        }
    </style>
</head>
<body>
    <div class="notfound-card">
        <i class="fa fa-exclamation-triangle fa-3x text-warning mb-3"></i>
        <div class="notfound-code">404</div>
        <h4 class="fw-semibold mt-2 mb-2">Halaman Tidak Ditemukan</h4>
        <p class="text-muted mb-4">
            Halaman yang Anda cari tidak tersedia atau sudah dipindahkan.
        </p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="/" class="btn btn-primary px-4">
                <i class="fa fa-home me-1"></i> Kembali ke Dashboard
            </a>
        }
        else
        {
            <a href="/Auth/Login" class="btn btn-primary px-4">
                <i class="fa fa-sign-in-alt me-1"></i> Masuk
            </a>
        }
    </div>
    <footer>Mitra Karya System &copy; @DateTime.Now.Year</footer>
</body>
</html>
