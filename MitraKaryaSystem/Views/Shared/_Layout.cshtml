<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link href="https://cdn.datatables.net/v/bs5/dt-1.13.7/r-2.5.0/sl-1.7.0/datatables.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css">
    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/css/site-custom.css" asp-append-version="true" />
    <style>
        .asterisk {
            color: red;
            margin-left: 3px;
        }
    </style>
</head>
<body class="hold-transition sidebar-mini  sidebar-collapse layout-footer-fixed">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-light-primary navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>
            <!-- Right navbar links -->
            <partial name="_LoginPartial" />
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a asp-action="Index" asp-controller="Home" class="navbar-brand brand-link">
                <img src="~/dist/image/logo.jpg" class="brand-image img-circle elevation-2">
                <span class="brand-text font-weight-light">@ViewData["Title"]</span>
            </a>
            <partial name="_SideBar" />

        </aside>
        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <!-- /.content-header -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <!-- Main content -->
                        <section class="content">
                            <div class="container-fluid">
                                @RenderBody()
                            </div><!--/. container-fluid -->
                        </section>
                    </div><!-- /.row -->
                </div><!-- /.container-fluid -->
            </div>
            <!-- /.content -->
        </div>
        <!-- Main Footer -->
        <partial name="_Footer" />
    </div>

    @* Ensure PaymentOut modal is on all pages *@
    @await Html.PartialAsync("_PaymentOutModal")

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script src="https://cdn.datatables.net/v/bs5/dt-1.13.7/r-2.5.0/sl-1.7.0/datatables.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    @{
        var userPermissions = User?.Claims?.Where(c => string.Equals(c.Type, "Permission", StringComparison.OrdinalIgnoreCase)).Select(c => c.Value).ToList() ?? new List<string>();
    }
    <script>window.__userPermissions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userPermissions));</script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
    <script>
        // Load notification badge + dropdown
        (async function () {
            try {
                const r = await Common.Api.get('/Home/AlertCount');
                if (r && r.count > 0) {
                    const badge = document.getElementById('alertBadge');
                    if (badge) { badge.textContent = r.count > 99 ? '99+' : r.count; badge.style.display = ''; }
                }
            } catch (_) { }
            // Lazy-load dropdown content on first open
            const bell = document.getElementById('navAlertBell');
            let loaded = false;
            if (bell) bell.addEventListener('show.bs.dropdown', async function () {
                if (loaded) return;
                loaded = true;
                try {
                    const data = await Common.Api.get('/Notification/GetAlerts');
                    const alerts = Array.isArray(data) ? data : [];
                    const body = document.getElementById('alertDropdownBody');
                    if (!alerts.length) { body.innerHTML = '<div class="text-center text-muted py-4"><i class="fa fa-check-circle text-success me-1"></i> No alerts</div>'; return; }
                    const iconMap = { LowStock: 'fa-box-open', OverdueDebt: 'fa-clock', PendingApproval: 'fa-hourglass-half', ExpiringConsignment: 'fa-handshake' };
                    const colorMap = { danger: 'text-danger', warning: 'text-warning', info: 'text-info' };
                    body.innerHTML = alerts.slice(0, 20).map(a => {
                        const icon = iconMap[a.type] || 'fa-bell';
                        const color = colorMap[a.severity] || 'text-secondary';
                        return `<a href="${a.link || '/Notification'}" class="dropdown-item px-3 py-2 border-bottom d-flex align-items-start gap-2">
                            <i class="fa ${icon} ${color} mt-1"></i>
                            <div class="flex-grow-1" style="white-space:normal;">
                                <div class="fw-semibold small">${a.title}</div>
                                <div class="text-muted" style="font-size:.75rem;">${a.message}</div>
                            </div>
                        </a>`;
                    }).join('');
                    if (alerts.length > 20) body.innerHTML += `<div class="text-center py-2"><a href="/Notification" class="small">View all ${alerts.length} alerts</a></div>`;
                } catch (e) {
                    document.getElementById('alertDropdownBody').innerHTML = '<div class="text-center text-muted py-3 small">Failed to load</div>';
                    loaded = false;
                }
            });
        })();
    </script>
    <script src="~/dist/js/adminlte.js"></script>
    <script src="~/js/shared/DataTable.js" asp-append-version="true"></script>
    <script src="~/js/shared/Print.js" asp-append-version="true"></script>
    <script src="~/js/shared/ProductSearch.js" asp-append-version="true"></script>
    <script src="~/js/PaymentOut.js" asp-append-version="true"></script>
    <!-- AdminLTE -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
