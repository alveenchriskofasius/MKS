@{ ViewData["Title"] = "Purchase Return"; }
<div class="container-fluid py-3" id="prApp">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold"><i class="fa fa-rotate-right text-primary"></i> Purchase Return</h3>
    <div>
      <button class="btn btn-sm btn-success" id="prNew"><i class="fa fa-plus"></i> New</button>
      <button class="btn btn-sm btn-primary" id="prSearch"><i class="fa fa-search"></i> Search</button>
      <button class="btn btn-sm btn-warning" id="prSave"><span class="spinner-border spinner-border-sm d-none"></span> <i class="fa fa-save"></i> Save</button>
    </div>
  </div>
  <div id="prHeader"></div>
  <div class="card shadow-sm mt-3">
    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
      <div><i class="fa fa-boxes-stacked me-1"></i> Items</div>
      <div class="input-group input-group-sm" style="width:340px">
        <span class="input-group-text"><i class="fa fa-barcode"></i></span>
        <input id="prProduct" class="form-control" placeholder="Type product name" />
        <button class="btn btn-outline-primary" id="prAdd"><i class="fa fa-plus"></i></button>
      </div>
    </div>
    <div class="card-body p-2">
      <table class="table table-sm table-bordered align-middle" id="tablePurchaseReturnItems" style="width:100%">
        <thead class="table-primary">
          <tr><th style="display:none">ProductID</th><th>Product</th><th class="text-end" style="width:120px">Qty</th><th class="text-end" style="width:120px">Unit Price</th><th class="text-end" style="width:140px">Subtotal</th><th style="width:40px"></th></tr>
        </thead>
      </table>
      <div class="text-end mt-2 pe-1"><span class="fw-semibold">Total: </span><span id="prTotal" class="badge text-bg-primary">0.00</span></div>
    </div>
  </div>
</div>
<div class="modal fade" id="prSearchModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header"><h5 class="modal-title"><i class="fa fa-search"></i> Search Purchase Return</h5><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body p-2"><table class="table table-sm" id="tablePurchaseReturnSearch" style="width:100%"><thead class="table-light"><tr><th>No</th><th>Date</th><th>Supplier</th><th>Amount</th><th></th></tr></thead></table></div></div></div></div>
@section Scripts { <script src="/js/PurchaseReturn.js"></script> }
