@{
    ViewData["Title"] = "Notifications";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-bell fa-lg"></i>
                <h5 class="mb-0">Notification & Alert Center</h5>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" id="btnRefresh"><i class="fa fa-sync me-1"></i>Refresh</button>
            </div>
        </div>
        <div class="card-body">
            <!-- Summary badges -->
            <div class="d-flex gap-3 mb-4 flex-wrap">
                <span class="badge rounded-pill text-bg-danger fs-6" id="badgeDanger">0 Critical</span>
                <span class="badge rounded-pill text-bg-warning fs-6" id="badgeWarning">0 Warning</span>
                <span class="badge rounded-pill text-bg-info fs-6" id="badgeInfo">0 Info</span>
            </div>

            <!-- Filter buttons -->
            <div class="btn-group mb-3" role="group">
                <button class="btn btn-sm btn-outline-secondary active" data-filter="all">All</button>
                <button class="btn btn-sm btn-outline-danger" data-filter="LowStock"><i class="fa fa-box-open me-1"></i>Low Stock</button>
                <button class="btn btn-sm btn-outline-warning" data-filter="OverdueDebt"><i class="fa fa-clock me-1"></i>Overdue Debt</button>
                <button class="btn btn-sm btn-outline-info" data-filter="PendingApproval"><i class="fa fa-hourglass-half me-1"></i>Pending PO</button>
                <button class="btn btn-sm btn-outline-primary" data-filter="ExpiringConsignment"><i class="fa fa-handshake me-1"></i>Consignment</button>
            </div>

            <!-- Alert list -->
            <div id="alertContainer">
                <div class="text-center text-muted py-5"><div class="spinner-border spinner-border-sm"></div> Loading alerts...</div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/Notification.js" asp-append-version="true"></script>
}
