@using API.Models
@{
    ViewData["Title"] = "Sales Order";
}
<style>
    /* DO progress stepper (SO-specific) */
    .do-progress { position: relative; width: 100%; }
    .do-step { text-align: center; flex: 1 1 0; position: relative; min-width: 100px; margin-bottom: 8px; }
    .do-step .circle { width: 32px; height: 32px; line-height: 32px; border-radius: 50%; background: var(--mks-gray-200); color: #555; margin: 0 auto 4px; font-weight: 600; transition: all .3s; font-size: .8rem; }
    .do-step.active-step .circle { background: var(--mks-primary); color: #fff; box-shadow: 0 0 0 3px rgba(37,99,235,.2); }
    .do-step .label { font-size: .62rem; font-weight: 600; text-transform: uppercase; letter-spacing: .5px; color: var(--mks-gray-600); }
    .do-step.active-step .label { color: var(--mks-primary); }
    .do-line { flex: 0 0 28px; height: 2px; background: var(--mks-gray-200); margin: 0 4px 24px 4px; position: relative; top: 15px; border-radius: 2px; }
    .do-step.active-step + .do-line { background: var(--mks-primary); }

    .swal2-html-container { text-align: left; width: 100%; }
    #assignDriverContainer select { min-width: 140px; }
    #deliveryOrderSection { animation: fadeSlideUp .4s ease; }
</style>
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-file-invoice-dollar fa-lg"></i>
                <h5 class="mb-0">Sales Order</h5>
            </div>
            <div class="d-flex gap-2">
                <button type="button" id="buttonNew" class="btn btn-sm btn-outline-light"><i class="fa-solid fa-plus"></i> New</button>
                <button type="button" id="buttonSearch" class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#searchModal"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
            </div>
        </div>
        <div class="card-body">
            <!-- Status & workflow -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="workflow-bar" id="soWorkflowBar">
                    <div class="wf-step active" data-step="1"><span class="wf-dot"></span> Draft</div>
                    <i class="fa fa-chevron-right wf-arrow"></i>
                    <div class="wf-step" data-step="2"><span class="wf-dot"></span> Paid</div>
                    <i class="fa fa-chevron-right wf-arrow"></i>
                    <div class="wf-step" data-step="8"><span class="wf-dot"></span> Completed</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-status badge-draft" id="salesOrderStatus">Draft</span>
                    <button class="btn btn-outline-success btn-sm d-none" id="btnCreateDO"><i class="fa fa-truck"></i> Create DO</button>
                    <button class="btn btn-outline-primary btn-sm" id="btnAddPayment"><i class="fa fa-cash-register"></i> Save &amp; Pay</button>
                </div>
            </div>

            <!-- Form -->
            <div class="card mb-3">
                <div class="card-body" id="salesOrderHeaderBody">
                    <partial name="_Form" model="new SalesOrderViewModel()" />
                </div>
                <div id="deliveryOrderSection" class="px-3 pb-3" style="display:none">
                    <div class="small text-muted mb-1"><i class="fa fa-truck me-1"></i>Delivery</div>
                    <div><strong>DO No:</strong> <span id="deliveryOrderNo">-</span> &nbsp; <span class="badge-status" id="deliveryOrderStatusBadge">-</span> <button class="btn btn-link btn-sm d-none" id="btnViewDO">view</button></div>
                </div>
            </div>

            <!-- Product selection -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-10">
                            <label class="form-label small fw-semibold">Add Product</label>
                            <select class="form-control select2" id="selectProduct" autofocus></select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items table -->
            <partial name="_TableProduct" />
            <partial name="_Table" />

        </div>
        <div class="card-footer d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary" id="buttonSave"><i class="fa fa-save"></i> Save</button>
            <a class="btn btn-secondary ms-auto" asp-action="Index" asp-controller="Home" id="buttonCancel"><i class="fa fa-arrow-left"></i> Back</a>
        </div>
    </div>
</div>

<partial name="~/Views/Shared/_PaymentInModal.cshtml" />

@section Scripts {
    <script src="~/js/SalesOrder.js" asp-append-version="true"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
    <script src="~/js/PaymentIn.js" asp-append-version="true"></script>
}