@using API.Models
@model SalesOrderViewModel
<form id="salesOrderForm">
    <input type="text" id="salesOrderID" hidden asp-for="SalesOrder.ID" />
    <input type="hidden" id="salesOrderStatusID" value="@Model.SalesOrder.StatusID" />
    <input type="hidden" id="salesOrderIsLocked" value="@Model.SalesOrder.IsLocked" />
    <div class="row">
        <div class="col-6">
            <div class="row mb-3">
                <label for="salesOrderNumber" class="form-label col-sm-2">No</label>
                <div class="col-md-6 col-lg-6">
                    <input type="text" asp-for=SalesOrder.No autofocus class="form-control" readonly id="salesOrderNumber" placeholder="Auto">
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <span id="salesOrderStatus" class="badge text-bg-secondary">Draft</span>
                </div>
            </div>
            <div class="row mb-3">
                <label for="salesOrderDate" class="form-label col-sm-2">Date</label>
                <div class="col-sm-6">
                    <input type="date" asp-for=SalesOrder.Date class="form-control" id="salesOrderDate">
                </div>
            </div>
            <div class="row mb-3" id="deliveryOrderSection" style="display:none;">
                <label class="form-label col-sm-2">DO</label>
                <div class="col-sm-10 d-flex gap-2 align-items-center">
                    <span id="deliveryOrderNo" class="fw-bold text-primary"></span>
                    <span id="deliveryOrderStatusBadge" class="badge bg-secondary">-</span>
                    <button type="button" id="btnViewDO" class="btn btn-sm btn-outline-primary d-none">View</button>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="row mb-3">
                <label for="selectCustomer" class="form-label col-sm-2">Customer</label>
                <div class="col-sm-10">
                    @Html.DropDownListFor(m => m.SalesOrder.CustomerID, Model.Customers, "Select a customer", new { @class = "form-control js-example-basic-responsive", id = "selectCustomer" })
                </div>
            </div>
            <div class="row mb-3">
                <label for="salesOrderNote" class="form-label col-sm-2">Note</label>
                <div class="col-sm-10">
                    <textarea class="form-control" id="salesOrderNote" asp-for="SalesOrder.Note"></textarea>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-sm-12 text-end">
                    <button type="button" id="btnCreateDO" class="btn btn-sm btn-outline-success d-none"><i class="fa fa-truck"></i> Create Delivery Order</button>
                </div>
            </div>
        </div>
    </div>
</form>