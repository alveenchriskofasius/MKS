@using API.Models
@model SalesOrderViewModel
<form id="salesOrderForm">
    <input type="text" id="salesOrderID" hidden asp-for="SalesOrder.ID" />
    <input type="hidden" id="salesOrderStatusID" value="@Model.SalesOrder.StatusID" />
    <input type="hidden" id="salesOrderIsLocked" value="@Model.SalesOrder.IsLocked" />
    <input type="hidden" id="salesOrderPaidAmount" value="@Model.SalesOrder.PaidAmount" />
    <div class="row g-3 align-items-end">
        <div class="col-auto">
            <label for="salesOrderNumber" class="form-label small mb-0 fw-semibold">No</label>
            <input type="text" asp-for=SalesOrder.No autofocus class="form-control form-control-sm" readonly id="salesOrderNumber" placeholder="Auto" style="width:160px">
        </div>
        <div class="col-auto">
            <label for="salesOrderDate" class="form-label small mb-0 fw-semibold">Date</label>
            <input type="date" asp-for=SalesOrder.Date class="form-control form-control-sm" id="salesOrderDate">
        </div>
        <div class="col-md-3">
            <label for="selectCustomer" class="form-label small mb-0 fw-semibold">Customer</label>
            @Html.DropDownListFor(m => m.SalesOrder.CustomerID, Model.Customers, "Select a customer", new { @class = "form-select form-select-sm", id = "selectCustomer" })
        </div>
        <div class="col-md-3">
            <label for="salesOrderNote" class="form-label small mb-0 fw-semibold">Note</label>
            <input type="text" class="form-control form-control-sm" id="salesOrderNote" asp-for="SalesOrder.Note" placeholder="Optional note..." />
        </div>
        <div class="col-auto ms-auto">
            <button type="button" id="btnCreateInvoice" class="btn btn-sm btn-outline-primary"><i class="fa fa-file-invoice"></i> Create Invoice</button>
        </div>
    </div>
</form>