@{
    ViewData["Title"] = "Purchase Order";
}
<div class="fade-slide-up">
    <div class="card page-header-card">
        <div class="card-header card-header-accent">
            <div class="d-flex align-items-center gap-2">
                <i class="fa fa-cart-shopping fa-lg"></i>
                <h5 class="mb-0">Purchase Order</h5>
            </div>
            <div class="d-flex gap-2">
                <button type="button" id="buttonNew" class="btn btn-sm btn-outline-light"><i class="fa-solid fa-plus"></i> New</button>
                <button type="button" id="buttonSearch" class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#searchModal"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
            </div>
        </div>
        <div class="card-body">
            <!-- Status & workflow -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="workflow-bar" id="poWorkflowBar">
                    <div class="wf-step active" data-step="1"><span class="wf-dot"></span> Draft</div>
                    <i class="fa fa-chevron-right wf-arrow"></i>
                    <div class="wf-step" data-step="2"><span class="wf-dot"></span> Submitted</div>
                    <i class="fa fa-chevron-right wf-arrow"></i>
                    <div class="wf-step" data-step="3"><span class="wf-dot"></span> Approved</div>
                </div>
                <span class="badge-status badge-draft" id="purchaseOrderStatus">Draft</span>
            </div>

            <!-- Form -->
            <div class="card mb-3">
                <div class="card-body" id="purchaseOrderHeaderBody"><!-- form partial will be loaded by JS --></div>
            </div>

            <!-- Product selection (outside card to avoid overflow clipping) -->
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-5">
                    <label class="form-label small fw-semibold">Supplier</label>
                    <select id="filterSupplier" class="form-control"></select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-semibold"><i class="fa fa-cart-plus me-1 text-primary"></i> Add Product</label>
                    <div class="mks-search-wrap">
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fa fa-barcode text-muted"></i></span>
                            <input type="text" class="form-control" id="selectProduct" placeholder="Type product name or scan barcode..." autocomplete="off" autofocus />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items table -->
            <div id="purchaseOrderTableContainer">
                @await Html.PartialAsync("_Table")
            </div>

            <!-- Payments -->
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold"><i class="fa fa-money-bill-wave me-1 text-muted"></i> Payments</span>
                    <button id="btnAddPaymentOut" class="btn btn-outline-primary btn-sm"><i class="fa fa-plus"></i> Add Payment</button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover" id="tablePaymentOutRelated">
                            <thead><tr><th>No</th><th>Date</th><th class="text-end">Amount</th><th>Method</th><th>Type</th><th class="text-center">Action</th></tr></thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
        <div class="card-footer d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-primary" id="buttonSave"><i class="fa fa-save"></i> Save</button>
            <button type="button" class="btn btn-outline-secondary" id="buttonPrint"><i class="fa fa-print"></i> Print</button>
            @if (User.HasClaim("Permission", "Purchase Order"))
            {
                <button type="button" class="btn btn-outline-info d-none" id="buttonSubmitPO"><i class="fa fa-paper-plane"></i> Submit</button>
                <button type="button" class="btn btn-outline-success d-none" id="buttonApprovePO"><i class="fa fa-check"></i> Approve</button>
                <button type="button" class="btn btn-outline-danger d-none" id="buttonRejectPO"><i class="fa fa-xmark"></i> Reject</button>
            }
            <button type="button" class="btn btn-outline-primary d-none" id="buttonCreateStockIn"><i class="fa fa-boxes-stacked"></i> Create Stock In</button>
            <a class="btn btn-secondary ms-auto" asp-action="Index" asp-controller="Home" id="buttonCancel"><i class="fa fa-arrow-left"></i> Back</a>
        </div>
    </div>
</div>
<!-- Search Modal -->
<div class="modal fade" id="searchModal" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header mks-modal-header">
                <h5 class="modal-title"><i class="fa fa-magnifying-glass me-2"></i>Search Purchase Orders</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm table-hover" cellpadding="0" cellspacing="0" width="100%" id="tableSearchPO">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                                <th>Status</th>
                                <th>Supplier</th>
                                <th>Created By</th>
                                <th>Updated By</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/PurchaseOrder.js" asp-append-version="true"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
    <script src="~/js/PaymentOut.js" asp-append-version="true"></script>
    <script>
        // Payment out related helpers for PO page
        $(document).ready(function(){
            // open modal prefilled for PO
            $('#btnAddPaymentOut').on('click', function(){
                const poId = parseInt($('#purchaseOrderID').val()||'0',10);
                if(!poId){ toastr.info('Save PO first'); return; }
                const supplierName = $('#purchaseOrderHeaderBody').find('#selectSupplier option:selected').text() || '';
                window.showPaymentOutModal($('#purchaseOrderHeaderBody').find('#supplierId').val()||$('#purchaseOrderHeaderBody').find('#purchaseOrderSupplierID').val()||0, supplierName, new Date().toISOString().slice(0,10), poId);
            });

            // load related payments when PO loaded
            // intercept form load by PurchaseOrder JS via polling for purchaseOrderID change
            function loadRelatedPayments(){
                const poId = parseInt($('#purchaseOrderID').val()||'0',10);
                if(!poId) { $('#tablePaymentOutRelated tbody').html('<tr><td colspan="6" class="text-center text-muted">No PO selected</td></tr>'); return; }
                $.get('/PaymentOut/RelatedByPO',{ purchaseOrderId: poId }, function(list){
                    let rows = (list||[]).map(p => `<tr><td>${p.no||''}</td><td>${Common.Format.Date(p.date)}</td><td class="text-end">${(Number(p.amount||0)).toFixed(2)}</td><td>${p.method||''}</td><td>${p.type||''}</td><td>${p.statusID==2?'<span class="badge bg-success">Submitted</span>':'<span class="badge bg-secondary">Draft</span>'}</td></tr>`).join('');
                    $('#tablePaymentOutRelated tbody').html(rows || '<tr><td colspan="6" class="text-center text-muted">No payments</td></tr>');
                }).fail(()=> $('#tablePaymentOutRelated tbody').html('<tr><td colspan="6" class="text-center text-muted">Failed load</td></tr>'));
            }

            // watch for PO id changes (simple interval) to refresh payments
            let lastPo = null;
            setInterval(function(){
                const cur = $('#purchaseOrderID').val()||'';
                if(cur !== lastPo){ lastPo = cur; loadRelatedPayments(); }
            }, 800);

            // initialize supplier filter for product selection
            // try to load supplier list into filter dropdown
            (function(){
                let endpoints = ['/PaymentOut/GetSupplierList','/Product/GetSupplierList','/Customer/GetList'];
                var supData = [];
                for(var i=0;i<endpoints.length;i++){
                    try{
                        var resp = Common.GetData.Get(endpoints[i]);
                        var list = (resp && resp.result && Array.isArray(resp.result)) ? resp.result : (Array.isArray(resp) ? resp : []);
                        if(list && list.length>0){ supData = list; break; }
                    }catch(e){}
                }
                $('#filterSupplier').append($('<option>').val('').text('All suppliers'));
                (supData||[]).forEach(function(s){
                    var id = s.id || s.ID || s.ID;
                    var name = s.supplierName || s.SupplierName || s.name || s.Name || (s.SupplierName && s.SupplierName) || '-';
                    $('#filterSupplier').append($('<option>').val(id).text(name));
                });
            })();
        });
    </script>
}