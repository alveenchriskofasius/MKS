@model UnitModel
<form id="unitForm">
    <input asp-for="@Model.ID" type="text" hidden />
    <div class="row g-3">
        <div class="col-12">
            <label asp-for="@Model.UnitName" class="form-label fw-semibold small">Unit Name <span class="text-danger">*</span></label>
            <input asp-for="@Model.UnitName" type="text" required class="form-control" placeholder="Enter unit name" />
            <div class="invalid-feedback">Please enter a unit name.</div>
        </div>
    </div>
</form>
