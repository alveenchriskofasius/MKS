@{
    ViewData["Title"] = "Point of Sale";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" href="~/css/pos.css" />
<div class="pos-container fade-slide-up">
  <div class="pos-action-bar">
    <span class="me-auto fw-semibold"><i class="fa fa-cash-register me-1 text-primary"></i> Point of Sale</span>
    <button class="btn btn-outline-secondary btn-sm me-1" id="posBtnHistory"><i class="fa fa-clock-rotate-left"></i> History</button>
    <button class="btn btn-outline-secondary btn-sm" id="posBtnCancel"><i class="fa fa-refresh"></i> Reset</button>
  </div>
  <div class="pos-panels">
    <!-- Left Panel: Search & Summary -->
    <div class="pos-panel flex-grow-1" style="min-width:280px;">
      <h5><i class="fa fa-search me-1 text-muted"></i> Find Product</h5>
      <div class="pos-search-wrap mb-2">
        <i class="fa fa-barcode icon"></i>
        <input type="text" id="posSearch" class="form-control" placeholder="Type name or scan barcode then Enter" autocomplete="off" />
      </div>
      <div class="pos-hint"><i class="fa fa-circle-info me-1"></i>Enter adds first result. ↑/↓ navigate suggestions.</div>

      <hr />

      <h5 class="mt-2"><i class="fa fa-receipt me-1 text-muted"></i> Cart Summary</h5>
      <div class="pos-summary p-3 mt-1">
        <div class="line"><span>Subtotal</span><span id="posSubtotal" class="fw-semibold">Rp 0</span></div>
        <div class="line"><span>Tax (11%)</span><span id="posTax">Rp 0</span></div>
        <hr />
        <div class="line total"><span>Total</span><span id="posTotal">Rp 0</span></div>
        <hr />

        <label class="form-label small mb-1 fw-semibold">Customer</label>
        <select id="posCustomer" class="form-select form-select-sm mb-2"></select>

        <label class="form-label small mb-1 fw-semibold">Payment Type</label>
        <div class="btn-group payment-toggle mb-2 w-100" role="group">
          <input type="radio" class="btn-check" name="posPayType" id="posPayFull" value="Full" checked>
          <label class="btn btn-outline-primary" for="posPayFull"><i class="fa fa-money-bill-1 me-1"></i>Full</label>
          <input type="radio" class="btn-check" name="posPayType" id="posPayDP" value="DP">
          <label class="btn btn-outline-primary" for="posPayDP"><i class="fa fa-hand-holding-dollar me-1"></i>DP</label>
          <input type="radio" class="btn-check" name="posPayType" id="posPayDebt" value="Piutang">
          <label class="btn btn-outline-primary" for="posPayDebt"><i class="fa fa-clock me-1"></i>Debt</label>
        </div>
        <div class="mb-3" id="posTenderWrap">
          <label class="form-label small fw-semibold" id="posTenderLabel">Cash Received</label>
          <input type="number" id="posTender" class="form-control form-control-sm" min="0" step="0.01" />
          <div class="d-flex justify-content-between mt-1" id="posChangeWrap">
            <span class="small text-muted">Change:</span>
            <span class="small fw-bold text-success" id="posChange">Rp 0</span>
          </div>
          <div class="d-flex justify-content-between mt-1 d-none" id="posDebtWrap">
            <span class="small text-muted">Remaining Debt:</span>
            <span class="small fw-bold text-danger" id="posDebt">Rp 0</span>
          </div>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-success flex-grow-1 pos-pay-btn" id="posBtnPay" disabled><i class="fa fa-shopping-cart me-1"></i> Pay & Save</button>
          <button class="btn btn-info" id="posBtnQris" disabled title="Pay with QRIS"><i class="fa fa-qrcode"></i></button>
        </div>
      </div>
    </div>

    <!-- Right Panel: Order Items -->
    <div class="pos-panel flex-grow-1" style="min-width:360px;">
      <h5><i class="fa fa-basket-shopping me-1 text-muted"></i> Order Items</h5>
      <div class="table-responsive" style="max-height:520px; overflow:auto;">
        <table class="table table-sm table-hover" id="posOrderTable">
          <thead>
            <tr>
              <th>Product</th>
              <th style="width:120px" class="text-center">Qty</th>
              <th class="text-end" style="width:110px">Price</th>
              <th class="text-end" style="width:120px">Total</th>
              <th style="width:50px" class="text-center"></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="small text-muted mt-2"><i class="fa fa-keyboard me-1"></i> Use +/- or type to adjust qty. Delete removes item.</div>
    </div>
  </div>
</div>

<!-- History Modal -->
<div class="modal fade" id="posHistoryModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header mks-modal-header">
        <h5 class="modal-title"><i class="fa fa-clock-rotate-left me-2"></i>POS Transaction History</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-2">
        <table class="table table-sm table-hover" id="tablePosHistory" style="width:100%">
          <thead class="table-light">
            <tr>
              <th>No</th>
              <th>Date</th>
              <th class="text-end">Amount</th>
              <th class="text-end">Paid</th>
              <th>Payment</th>
              <th>Customer</th>
              <th>Status</th>
              <th>Cashier</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- QRIS Modal -->
<div class="modal fade" id="qrisModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-info text-white py-2">
        <h6 class="modal-title"><i class="fa fa-qrcode me-1"></i> Scan QRIS to Pay</h6>
      </div>
      <div class="modal-body text-center">
        <div id="qrisLoading" class="py-4"><div class="spinner-border text-info"></div><div class="mt-2 text-muted">Generating QR Code...</div></div>
        <div id="qrisContent" style="display:none;">
          <img id="qrisImage" src="" alt="QRIS" class="img-fluid mb-3" style="max-width:240px;" />
          <div class="fw-bold fs-5 mb-1" id="qrisAmount"></div>
          <div class="small text-muted mb-3">Scan with any e-wallet / mobile banking</div>
          <div id="qrisStatus" class="mb-2">
            <span class="badge text-bg-warning"><i class="fa fa-clock me-1"></i>Waiting for payment...</span>
          </div>
        </div>
        <div id="qrisDone" style="display:none;">
          <i class="fa fa-check-circle text-success fa-3x mb-2"></i>
          <div class="fw-bold text-success fs-5">Payment Received!</div>
        </div>
        <div id="qrisError" style="display:none;" class="text-danger"></div>
      </div>
      <div class="modal-footer py-1">
        <button class="btn btn-secondary btn-sm" id="qrisBtnCancel"><i class="fa fa-times me-1"></i>Cancel</button>
      </div>
    </div>
  </div>
</div>

@await Html.PartialAsync("_PaymentInModal")
@section Scripts{
  <script src="~/js/PaymentIn.js" asp-append-version="true"></script>
  <script src="~/js/Pos.js" asp-append-version="true"></script>
}
