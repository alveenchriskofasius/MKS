@{
    ViewData["Title"] = "Access Denied";
    Layout = "_LayoutLogin";
}

<div class="text-center">
    <div class="mb-3">
        <i class="fa fa-shield-halved" style="font-size:3.5rem;color:#dc2626;"></i>
    </div>
    <h3 style="color:#dc2626;font-weight:700;">Access Denied</h3>
    <p class="subtitle">You don't have permission to access this page.</p>
    <p style="color:#64748b;font-size:.85rem;">Please contact your administrator to get access.</p>
    <a class="btn btn-login mt-2" asp-controller="Home" asp-action="Index">
        <i class="fa fa-arrow-left me-1"></i> Go to Dashboard
    </a>
</div>