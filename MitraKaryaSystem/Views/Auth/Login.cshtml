@model LoginModel
@{
	Layout = "_LayoutLogin";
	ViewData["Title"] = "Login";
}

<h3>Welcome Back</h3>
<p class="subtitle">Sign in to your account to continue</p>
<form id="account" method="post">
	<div class="form-floating">
		<input asp-for="@Model.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="Username" />
		<label asp-for="@Model.UserName"><i class="fa fa-user me-1"></i>Username</label>
		<span asp-validation-for="@Model.UserName" class="text-danger small"></span>
	</div>
	<div class="form-floating">
		<input asp-for="@Model.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
		<label asp-for="@Model.Password"><i class="fa fa-lock me-1"></i>Password</label>
		<span asp-validation-for="@Model.Password" class="text-danger small"></span>
	</div>
	<div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
	<button id="login-submit" type="submit" class="w-100 btn btn-login">
		<i class="fa fa-right-to-bracket me-1"></i> Sign In
	</button>
</form>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}