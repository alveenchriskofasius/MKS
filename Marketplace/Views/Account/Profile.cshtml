@{
    ViewData["Title"] = "Pengaturan Profil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="text-center mb-4">
                <i class="bi bi-gear" style="font-size:3rem;color:var(--mp-green);"></i>
                <h4 class="fw-bold mt-2">Pengaturan Profil</h4>
                <p class="text-muted small">Perbarui informasi akun kamu</p>
            </div>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div id="profileLoading" class="text-center py-4">
                        <div class="spinner-border" style="color:var(--mp-green);" role="status"></div>
                    </div>
                    <div id="profileForm" style="display:none;">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" class="form-control" id="profileEmail" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nama Lengkap</label>
                            <input type="text" class="form-control" id="profileName"
                                   placeholder="Masukkan nama lengkap" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">No. HP</label>
                            <input type="text" class="form-control" id="profilePhone"
                                   placeholder="Masukkan nomor HP" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Alamat</label>
                            <textarea class="form-control" id="profileAddress" rows="3"
                                      placeholder="Masukkan alamat lengkap" required></textarea>
                        </div>
                        <div id="profileError" class="alert alert-danger" style="display:none;"></div>
                        <div id="profileSuccess" class="alert alert-success" style="display:none;"></div>
                        <button class="btn btn-warning w-100 py-2" id="btnSaveProfile">
                            <span class="spinner-border spinner-border-sm"
                                  style="display:none;" id="profileSpinner"></span> Simpan Perubahan
                        </button>
                    </div>
                </div>
            </div>
            <div class="text-center mt-3">
                <a href="/" class="btn btn-outline-dark btn-sm">
                    <i class="bi bi-arrow-left"></i> Kembali ke Home
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Account/Profile.js" asp-append-version="true"></script>
}
