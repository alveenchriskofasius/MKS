@{
    ViewData["Title"] = "Masuk";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="text-center mb-4">
                <i class="bi bi-person-circle" style="font-size:3rem;color:var(--mp-green);"></i>
                <h4 class="fw-bold mt-2">Masuk</h4>
                <p class="text-muted small">Masuk ke akun Marketplace kamu</p>
            </div>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" class="form-control" id="loginEmail" placeholder="Masukkan email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Password</label>
                        <input type="password" class="form-control" id="loginPassword" placeholder="Masukkan password" required />
                    </div>
                    <div id="loginError" class="alert alert-danger" style="display:none;"></div>
                    <button class="btn btn-warning w-100 py-2" id="btnLogin">
                        <span class="spinner-border spinner-border-sm" style="display:none;" id="loginSpinner"></span> Masuk
                    </button>
                    <hr />
                    <p class="text-center mb-0 small">
                        Belum punya akun? <a href="/Account/Register" class="fw-semibold">Daftar di sini</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Account/Login.js" asp-append-version="true"></script>
}
