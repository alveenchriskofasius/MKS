@{
    ViewData["Title"] = "Notifikasi";
}

<div class="container py-4" style="max-width:720px;">
    <h4 class="fw-bold mb-3"><i class="bi bi-bell"></i> Notifikasi</h4>

    <div id="notifLoading" class="text-center py-5">
        <div class="spinner-border" style="color:var(--mp-green);" role="status"></div>
    </div>
    <div id="notifEmpty" class="text-center py-5" style="display:none;">
        <i class="bi bi-bell-slash" style="font-size:4rem;color:#ccc;"></i>
        <p class="text-muted mt-3">Belum ada notifikasi.</p>
    </div>
    <div id="notifContent" style="display:none;">
        <div class="list-group" id="notifList"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Notification/Index.js" asp-append-version="true"></script>
}
