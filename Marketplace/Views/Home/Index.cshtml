@{
    ViewData["Title"] = "Mitra Karya – Toko Bangunan Terpercaya";
}

<!-- Popular Products (horizontal scroll, shown only when not filtering) -->
<section class="py-3 border-bottom" id="sectionPopular" style="display:none;background:#fff;">
    <div class="container">
        <div class="d-flex align-items-center mb-2">
            <h6 class="section-title mb-0 me-2"><i class="bi bi-fire me-1" style="color:var(--mp-red);"></i> Produk Terlaris</h6>
        </div>
        <div class="d-flex gap-3 overflow-auto pb-1 popular-scroll" id="popularList" style="flex-wrap:nowrap;"></div>
    </div>
</section>

<!-- Main: Category Sidebar + Product Grid -->
<div class="container py-4">
    <div class="row g-4">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2">
            @await Html.PartialAsync("_CategorySidebar")
        </div>
        <!-- Product Grid -->
        <div class="col-md-9 col-lg-10">
            @await Html.PartialAsync("_ProductGrid")
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Home/Index.js" asp-append-version="true"></script>
}
