<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top mp-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shop-window"></i> Mitra Karya
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <form class="d-flex mx-auto my-2 my-lg-0" style="max-width:480px;width:100%;" id="searchForm">
                    <div class="input-group">
                        <input class="form-control border-end-0" type="search" id="searchInput" placeholder="Cari di Marketplace" />
                        <button class="btn btn-success" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>
                <ul class="navbar-nav ms-auto align-items-center">
                    <!-- Wishlist -->
                    <li class="nav-item" id="navWishlist" style="display:none;">
                        <a class="nav-link position-relative" asp-controller="Wishlist" asp-action="Index"
                           title="Wishlist">
                            <i class="bi bi-heart fs-5"></i>
                            <span id="wishlist-badge" class="badge rounded-pill wishlist-badge" style="display:none;">0</span>
                        </a>
                    </li>
                    <!-- Notification -->
                    <li class="nav-item" id="navNotification" style="display:none;">
                        <a class="nav-link position-relative" asp-controller="Notification" asp-action="Index"
                           title="Notifikasi">
                            <i class="bi bi-bell fs-5"></i>
                            <span id="notif-badge" class="badge rounded-pill notif-badge" style="display:none;">0</span>
                        </a>
                    </li>
                    <!-- Cart -->
                    <li class="nav-item">
                        <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-cart3 fs-5"></i>
                            <span id="cart-badge" class="badge rounded-pill cart-badge" style="display:none;">0</span>
                        </a>
                    </li>
                    <!-- Account: shown/hidden by JS based on auth state -->
                    <li class="nav-item" id="navGuest" style="display:none;">
                        <a class="nav-link btn btn-outline-success btn-sm ms-2 px-3" asp-controller="Account" asp-action="Login">
                            Masuk
                        </a>
                    </li>
                    <li class="nav-item dropdown" id="navUser" style="display:none;">
                        <a class="nav-link dropdown-toggle" href="#"
                           role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i>
                            <span id="navUserName"></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Order" asp-action="Index">
                                    <i class="bi bi-bag"></i> Pesanan Saya
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Complaint" asp-action="Index">
                                    <i class="bi bi-exclamation-triangle"></i> Komplain
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Notification" asp-action="Index">
                                    <i class="bi bi-bell"></i> Notifikasi
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item"
                                   asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-gear"></i> Pengaturan
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger"
                                   asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Keluar
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="mp-footer py-4 mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h6 class="mb-2"><i class="bi bi-shop-window text-success"></i> <span id="footerStoreName">TB. Mitra Karya</span></h6>
                    <p class="text-muted small mb-1"><i class="bi bi-geo-alt me-1"></i> <span id="footerAddress">Jl. Raya Lemahabang No 8.A</span></p>
                    <p class="text-muted small mb-1"><i class="bi bi-telephone me-1"></i> <span id="footerPhone">0218906162</span></p>
                    <div id="footerSchedule">
                        <p class="text-muted small mb-1"><i class="bi bi-clock me-1"></i> Senin&ndash;Sabtu: 08.00&ndash;17.00 WIB</p>
                        <p class="text-muted small mb-0"><i class="bi bi-clock me-1"></i> Minggu: 08.00&ndash;14.00 WIB</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <h6 class="mb-2">Tautan</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-1"><a asp-controller="About" asp-action="Index" class="text-muted small"><i class="bi bi-info-circle me-1"></i>Tentang Kami</a></li>
                        <li class="mb-1"><a asp-controller="Faq" asp-action="Index" class="text-muted small"><i class="bi bi-question-circle me-1"></i>FAQ &amp; Bantuan</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy" class="text-muted small"><i class="bi bi-shield-check me-1"></i>Kebijakan Privasi</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="mb-2">Lokasi Kami</h6>
                    <a href="/About" class="text-muted small d-flex align-items-center gap-1">
                        <i class="bi bi-map text-success"></i> Lihat Peta &amp; Info Toko
                    </a>
                    <p class="text-muted small mt-2 mb-0">&copy; @DateTime.Now.Year Mitra Karya. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Common.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
