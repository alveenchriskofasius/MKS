@{
    ViewData["Title"] = "Keranjang Belanja";
}

<div class="container py-4">
    <h4 class="fw-bold mb-3"><i class="bi bi-cart3"></i> Keranjang</h4>

    <div id="cartLoading" class="mp-loading">
        <div class="spinner-border" role="status"></div>
        <p>Memuat keranjang...</p>
    </div>

    <div id="cartEmpty" class="text-center py-5" style="display:none;">
        <i class="bi bi-cart-x" style="font-size:4rem;color:#ccc;"></i>
        <p class="text-muted mt-3">Keranjang belanja kamu masih kosong.</p>
        <a href="/Catalog" class="btn btn-warning">
            <i class="bi bi-grid"></i> Mulai Belanja
        </a>
    </div>

    <div id="cartContent" style="display:none;">
        <partial name="_CartTable" />
        <partial name="_CartSummary" />
    </div>
</div>

@section Scripts {
    <script src="~/js/Cart/Index.js" asp-append-version="true"></script>
}
