@{
    ViewData["Title"] = "Katalog Produk";
}

<div class="container py-4">
    <div class="row">
        <!-- Sidebar: Categories -->
        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-body p-0">
                    <h6 class="fw-bold px-3 pt-3 pb-2 mb-0"><i class="bi bi-funnel"></i> Kategori</h6>
                    <div class="list-group list-group-flush" id="categorySidebar">
                        <a href="#" class="list-group-item list-group-item-action active cat-filter" data-id="">
                            Semua Produk
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Grid -->
        <div class="col-md-9">
            <p class="text-muted" id="searchInfo" style="display:none;">
                Hasil pencarian: <strong id="searchTerm"></strong>
            </p>
            <div class="alert alert-light border" id="emptyState" style="display:none;">
                <i class="bi bi-info-circle"></i> Tidak ada produk ditemukan.
            </div>
            <div class="row row-cols-2 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3" id="productGrid"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Catalog/Index.js" asp-append-version="true"></script>
}
